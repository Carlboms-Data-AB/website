---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Carlboms Data — Relationsexperten för systemintegration',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Boka ett förutsättningslöst rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Systemintegration mellan IT och OT',
    }}
  >
    <Fragment slot="title">
      Relationsexperten för <span class="text-accent">systemintegration</span>
    </Fragment>

    <Fragment slot="subtitle">
      Alla bra relationer kräver fungerande kommunikation. Särskilt när OT ska prata med IT.
    </Fragment>
  </Hero>

  <Content
    tagline="Om Carlboms Data"
    title="Jag bygger broar mellan system"
    items={[]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Systemintegration',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        Alla bra relationer kräver fungerande kommunikation. Det gäller även maskiner och IT-system.
        Så om de talar förbi varandra, finns jag där. Hjälper dem att hitta tillbaka till varandra
        när de har fått en fnurra på tråden.
      </p>
      <p class="text-lg text-muted">
        Med lång erfarenhet, skräddarsydda lösningar och programvara med öppen källkod är Carlboms Data
        din relationsexpert som bygger broar mellan system.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features
    id="usps"
    tagline="Därför Carlboms Data"
    title="Tre skäl att välja mig"
    items={[
      {
        title: 'Teknisk medlare mellan IT och OT',
        description:
          'Jag hjälper dig att bryta ner silotänkandet och bygga säkra integrationer som möter både produktionens realtidsstrikta krav och IT-sidans säkerhetsprotokoll.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Skräddarsytt med öppen källkod',
        description:
          'Äkta relationer bygger på frihet. Därför undviker jag proprietära "svarta lådor" och skapar transparenta lösningar där du alltid äger din egen kod.',
        icon: 'tabler:lock-open',
      },
      {
        title: 'Agilt och personligt',
        description:
          'Med Carlboms Data får du korta beslutsvägar och direktkontakt med experten. Inga juniora konsulter eller byråkratiska startsträckor. Tillsammans börjar vi lösa problemet direkt.',
        icon: 'tabler:user-check',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Boka ett förutsättningslöst rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      Dags att lösa fnurran<br class="block sm:hidden" /> på tråden?
    </Fragment>

    <Fragment slot="subtitle">
      Beskriv din utmaning, så hör jag av mig.
    </Fragment>
  </CallToAction>
</Layout>
