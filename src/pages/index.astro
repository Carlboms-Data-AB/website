---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Carlboms Data — Relationsexperten för systemintegration',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Boka ett förutsättningslöst rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Industriellt nätverk och kablar',
    }}
  >
    <Fragment slot="title">
      Relationsexperten för <span class="text-accent">systemintegration</span>
    </Fragment>

    <Fragment slot="subtitle">
      Alla bra relationer kräver fungerande kommunikation. Särskilt när OT ska prata med IT.
    </Fragment>
  </Hero>

  <Content
    tagline="Om Carlboms Data"
    title="Jag bygger broar mellan system"
    items={[]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Industriell produktion',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        Alla bra relationer kräver fungerande kommunikation. Det gäller även maskiner och IT-system.
        Så om de talar förbi varandra, finns jag där. Hjälper dem att hitta tillbaka till varandra
        när de har fått en fnurra på tråden.
      </p>
      <p class="text-lg text-muted">
        Med lång erfarenhet, skräddarsydda lösningar och programvara med öppen källkod är Carlboms Data
        din relationsexpert som bygger broar mellan system.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Teknisk sektion: vad jag faktiskt gör -->
  <Features
    id="vad-jag-gor"
    tagline="Konkret"
    title="Det här gör jag"
    subtitle="Jag bygger mellanlagret som saknas — den logik och de kopplingar som krävs för att era system ska utbyta data sömlöst."
    items={[
      {
        title: 'Systemintegration OT/IT',
        description:
          'Kopplar samman PLC, SCADA och maskiner med affärssystem, databaser och molntjänster. API-utveckling, middleware och dataflöden.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Automation & PLC-programmering',
        description:
          'Programmering och optimering av styrsystem med CODESYS — leverantörsoberoende och portabelt.',
        icon: 'tabler:cpu',
      },
      {
        title: 'HMI, SCADA & övervakning',
        description:
          'Operatörsgränssnitt, SCADA och realtidsövervakning. CODESYS, WinCC, WideQuick, FUXA och egenutvecklade webbaserade gränssnitt med larmhantering.',
        icon: 'tabler:device-desktop-analytics',
      },
      {
        title: 'Mjukvaruutveckling',
        description:
          'C#/.NET, Python, T-SQL, CODESYS Structured Text, JavaScript, Flux, HTML/CSS. Backend-tjänster, databearbetning och webbaserade verktyg.',
        icon: 'tabler:code',
      },
      {
        title: 'Säker fjärråtkomst',
        description:
          'VPN-lösningar, nätverkssegmentering och fjärranslutning till industriella anläggningar — felsök utan att vara på plats.',
        icon: 'tabler:network',
      },
      {
        title: 'Felsökning & optimering',
        description:
          'Diagnostik och prestandaoptimering av befintliga system — PLC-logik, nätverkskonfiguration, databaser och applikationskod.',
        icon: 'tabler:bug',
      },
    ]}
  />

  <!-- Varför Carlboms Data (copywriterns USP:ar) -->
  <Content
    isReversed
    tagline="Därför Carlboms Data"
    title="Tre skäl att välja mig"
    items={[
      {
        title: 'Teknisk medlare mellan IT och OT',
        description:
          'Jag hjälper dig att bryta ner silotänkandet och bygga säkra integrationer som möter både produktionens realtidsstrikta krav och IT-sidans säkerhetsprotokoll.',
      },
      {
        title: 'Inga inlåsningar — du äger koden',
        description:
          'Äkta relationer bygger på frihet. Därför undviker jag proprietära "svarta lådor" och skapar transparenta lösningar där du alltid äger din egen kod.',
      },
      {
        title: 'Agilt och personligt',
        description:
          'Korta beslutsvägar och direktkontakt med experten. Inga juniora konsulter eller byråkratiska startsträckor. Vi börjar lösa problemet direkt.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Samarbete och teknik',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Boka ett förutsättningslöst rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      Låt oss prata
    </Fragment>

    <Fragment slot="subtitle">
      Beskriv din utmaning, så hör jag av mig.
    </Fragment>
  </CallToAction>
</Layout>
