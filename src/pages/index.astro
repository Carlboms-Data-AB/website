  .form-status { font: 500 14px/20px var(--font-sans); padding: 12px 16px; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px; justify-content: center; }
  .form-success { background: rgba(22,176,121,0.08); color: var(--brand-green-deep); }
  .form-error { background: rgba(220,38,38,0.06); color: #b91c1c; }
  .form-error a { color: inherit; text-decoration: underline; }
