    cursor: pointer; transition: opacity 120ms ease, transform 120ms ease;
  }
  .form-submit:hover { opacity: .86; }
  .form-submit:active { transform: scale(.985); }
  .form-submit:disabled { opacity: 0.55; cursor: not-allowed; }
