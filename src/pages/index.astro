---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import portraitImg from '~/assets/images/tobias-portrait.jpg';

const metadata = {
  title: 'Carlboms Data — IT och automation för tillverkningsindustrin',
  description: 'Jag får IT och automation att fungera tillsammans. MES/ERP-integration och specialutvecklade program för tillverkningsindustrin — ingen inlåsning, ni äger alltid koden.',
  ignoreTitleTemplate: true,
};

// Kompetensområden — de två positioneringspelarna först, därefter djupet
const tjanster = [
  { icon: 'git-merge', title: 'MES/ERP-integration', body: 'Integrerar affärssystem, produktionssystem och databaser så att information flödar automatiskt mellan systemen.', chips: ['MES / ERP', 'SQL', 'API'] },
  { icon: 'code', title: 'Specialutvecklade program', body: 'När standardlösningar inte räcker bygger jag det som gör exakt det verksamheten behöver.', chips: ['C# / .NET', 'Python', 'SQL'] },
  { icon: 'cpu', title: 'Automation och styrsystem', body: 'Programmering, felsökning och optimering av styrsystem för en stabil och effektiv produktion.', chips: ['CODESYS', 'Structured Text', 'J1939'] },
  { icon: 'monitor', title: 'Operatörsgränssnitt och övervakning', body: 'Rätt information till rätt person — i produktionen och på kontoret.', chips: ['WinCC', 'FUXA', 'Grafana'] },
  { icon: 'shield-check', title: 'Säker fjärråtkomst', body: 'Era tekniker kommer åt maskiner och produktionssystem utan att åka ut på plats.', chips: ['WireGuard', 'VLAN', 'SSH'] },
  { icon: 'search', title: 'Felsökning av befintliga system', body: 'Jag hittar grundorsaken till problemen — även när flera system är inblandade.', chips: ['Root-cause', 'Prestanda', 'Akut support'] },
];

// Konkurrensfördelar — samlade på ett ställe i stället för utspridda i löptext
const fordelar = [
  { title: 'Kan både IT och automation', body: 'Jag behöver aldrig lämna över mellan styrsystemet och affärssystemet.' },
  { title: 'En kontaktperson', body: 'Ni pratar med den som faktiskt bygger lösningen.' },
  { title: 'Ni äger alltid koden', body: 'Koden är er. Ingen licens som håller den gisslan.' },
  { title: 'Ingen leverantörsinlåsning', body: 'Jag väljer teknik som går att flytta, byta och underhålla av andra.' },
  { title: 'Ansvar hela vägen', body: 'Från givare och styrsystem till databas, API och rapport.' },
  { title: 'Felsöker även andras lösningar', body: 'Ni behöver inte ha byggt det med mig för att jag ska kunna laga det.' },
];

// Utvalda projekt (originaltext från referenssidan)
const cases = [
  {
    cat: 'MES/ERP-integration',
    kund: 'Tillverkningsföretag med flera produktionssystem',
    title: 'Smidigare dataflöden utan handpåläggning.',
    metric: '0', metricUnit: 'manuella inmatningar', metricLabel: 'Rapporter som tog timmar — nu på sekunder.',
    tech: ['C# / .NET', 'T-SQL', 'ODBC', 'HTTP / REST', 'Grafana'],
    utmaning: 'Kunden matade in data från flera produktionssystem för hand i affärssystemet. Det tog mycket tid och gav återkommande fel i siffrorna.',
    losning: 'Jag kopplade ihop produktionssystemen med affärssystemet så att datan flödar automatiskt, utan mellanhänder.',
    resultat: 'Den manuella inmatningen försvann. Produktionsledarna väntade tidigare flera timmar på rapporter — nu genereras de automatiskt på sekunder, med färre fel.',
  },
  {
    cat: 'Säker fjärråtkomst',
    kund: 'Industriföretag med anläggningar på flera orter',
    title: 'Närhet på distans för snabbare felsökning.',
    metric: '15', metricUnit: 'minuter', metricLabel: 'Tidigare en hel resdag — nu en kvart.',
    tech: ['WireGuard', 'VLAN', 'SSH', 'DNS', 'Bash'],
    utmaning: 'Vid varje fel på en anläggning behövde en tekniker åka ut på plats — både dyrt och långsamt.',
    losning: 'Jag satte upp en säker fjärranslutning som ger teknikerna full tillgång till utrustningen direkt från kontoret.',
    resultat: 'En felsökning som tidigare krävde en hel resdag klaras nu av på en kvart — utan att någon lämnar kontoret.',
  },
  {
    cat: 'Optimering',
    kund: 'Svensk kabeltillverkare',
    title: 'Nytt liv i gamla styrsystem.',
    metric: '10×', metricUnit: 'snabbare', metricLabel: 'Systemoptimering — utan att byta ut systemet.',
    tech: ['C# / .NET', 'WPF', 'ODBC'],
    utmaning: 'En kabeltillverkares egenutvecklade styrsystem hade blivit så långsamt att det påverkade produktionen.',
    losning: 'Istället för att byta ut systemet optimerade jag den befintliga koden från grunden.',
    resultat: 'Styrsystemet gick från oanvändbart långsamt till snabbt och responsivt — och operatörerna sparar flera timmar om dagen.',
  },
];

const iconPaths: Record<string, string> = {
  'git-merge': 'M7 7a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 0v10m8-4a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm0 0H7',
  'cpu': 'M5 5h14v14H5zm4-3v3m6-3v3M5 9h-3m3 6h-3m17-6h3m-3 6h3M9 22v-3m6 3v-3',
  'monitor': 'M3 5h18v12H3zm5 16h8m-4-4v4',
  'code': 'M8 7l-5 5 5 5m8-10l5 5-5 5',
  'shield-check': 'M12 2l8 4v6c0 5.5-3.8 10.7-8 12-4.2-1.3-8-6.5-8-12V6l8-4zm-2 10l2 2 4-4',
  'search': 'M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm10 18l-4-4',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="hero-section" id="top">
    <div class="hero-backdrop" aria-hidden="true">
      <div class="hero-gradient"></div>
      <div class="hero-grid-texture"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-center">
        <h1 class="display-hero">
          Jag får IT och automation att fungera tillsammans.
        </h1>
        <p class="lead" style="margin-top:28px;max-width:720px;margin-left:auto;margin-right:auto;">
          MES/ERP-integration och specialutvecklade verktyg för tillverkningsindustrin.
        </p>
        <div class="hero-actions">
          <a href="#kontakt" class="cta">
            Boka ett rådgivningssamtal
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="#tjanster" class="cta secondary">Se mina tjänster</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tjänster -->
  <section class="section tight" id="tjanster">
    <div class="container">
      <div class="section-intro">
        <div class="eyebrow"><span class="dot"></span>Mina tjänster</div>
        <h2 class="display-section" style="margin-top:14px;">Det här hjälper jag er med.</h2>
      </div>

      <div class="tjanst-grid">
        {tjanster.map((t, i) => (
          <article class="card tjanst-card">
            <div class="tjanst-head">
              <div class="tjanst-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={iconPaths[t.icon]} /></svg>
              </div>
              <span class="tjanst-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="display-card" style="margin-top:16px;font-size:20px;">{t.title}</h3>
            <p class="tjanst-body">{t.body}</p>
            <div class="tjanst-chips">
              {t.chips.map(c => <span class="chip">{c}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Varför Carlboms Data -->
  <section class="section tight" id="varfor" style="background:var(--color-canvas);">
    <div class="container">
      <div class="section-intro">
        <div class="eyebrow"><span class="dot"></span>Varför Carlboms Data</div>
        <h2 class="display-section" style="margin-top:14px;">En konsult som täcker hela kedjan.</h2>
      </div>

      <div class="fordel-grid">
        {fordelar.map(f => (
          <div class="fordel">
            <span class="fordel-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <div>
              <h3 class="fordel-title">{f.title}</h3>
              <p class="fordel-body">{f.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Referenser -->
  <section class="section tight" id="referenser">
    <div class="container">
      <div class="section-intro">
        <div class="eyebrow"><span class="dot"></span>Referenser</div>
        <h2 class="display-section" style="margin-top:14px;">Utvalda projekt.</h2>
      </div>

      <div class="cases-stack">
        {cases.map((c, idx) => (
          <article class="case-card">
            <div class="case-left">
              <div class="case-meta">
                <span class="case-meta-num">{String(idx + 1).padStart(2, '0')}</span>
                <span class="case-meta-sep">&middot;</span>
                <span class="case-meta-cat">{c.cat}</span>
              </div>
              <h3 class="case-title">{c.title}</h3>
              <div class="case-kund">{c.kund}</div>
              <div class="case-metric-card">
                <div class="case-metric-row">
                  <span class="case-metric-num">{c.metric}</span>
                  <span class="case-metric-unit">{c.metricUnit}</span>
                </div>
                <div class="case-metric-label">{c.metricLabel}</div>
              </div>
              <div class="case-tech">
                <div class="case-tech-label">Tekniker</div>
                <div class="case-tech-chips">
                  {c.tech.map((t: string) => <span class="case-tech-chip">{t}</span>)}
                </div>
              </div>
            </div>
            <div class="case-right">
              <div class="case-section">
                <div class="case-section-label">
                  <span class="cs-dot" style="background:#c50000;"></span>
                  Utmaningen
                </div>
                <p>{c.utmaning}</p>
              </div>
              <div class="case-section">
                <div class="case-section-label">
                  <span class="cs-dot" style="background:var(--color-ink);"></span>
                  Lösningen
                </div>
                <p>{c.losning}</p>
              </div>
              <div class="case-section">
                <div class="case-section-label">
                  <span class="cs-dot" style="background:#0e7a55;"></span>
                  Resultatet
                </div>
                <p>{c.resultat}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Om -->
  <section class="section tight" id="om" style="background:var(--color-canvas);">
    <div class="container">
      <div class="om-grid">
        <div class="om-text">
          <div class="eyebrow"><span class="dot"></span>Om Carlboms Data</div>
          <h2 class="display-section" style="margin-top:14px;">Jag arbetar i båda världarna.</h2>
          <div class="om-body">
            <p>Jag heter Tobias Carlbom. Jag har arbetat med programmering, automation och systemintegration i många år — och det roligaste är fortfarande att lösa problem där flera system måste samarbeta.</p>
            <p>De flesta konsulter arbetar antingen med IT eller med automation. Jag arbetar i båda världarna och bygger lösningarna mellan dem. Därför kan jag ta ansvar för hela lösningen i stället för en liten del av den — ingen behöver stå emellan och tolka, och ansvaret faller aldrig mellan två leverantörer.</p>
            <p>I en bransch där systemintegration ofta handlar om att sälja in stora plattformar och låsa in kunden, ville jag vara en prestigelös motreaktion. Det är därför jag bygger broar mellan de två världarna — med robusta, skräddarsydda lösningar som håller över tid. Och det är därför jag alltid låter er äga koden.</p>
          </div>
          <div class="om-sig">
            <div class="om-sig-name">Tobias Carlbom</div>
            <div class="om-sig-role">Grundare · Carlboms Data AB · Lund</div>
          </div>
        </div>
        <div class="om-portrait-wrap">
          <div class="om-portrait">
            <Image src={portraitImg} alt="Tobias Carlbom" width={600} height={800} style="width:100%;height:100%;object-fit:cover;display:block;" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kontakt -->
  <section class="kontakt-section" id="kontakt">
    <div class="kontakt-bg" aria-hidden="true"></div>
    <div class="container" style="position:relative;">
      <div class="kontakt-grid">
        <div>
          <div class="eyebrow" style="color:rgba(255,255,255,0.55);">
            <span style="width:6px;height:6px;border-radius:50%;background:var(--brand-green);display:inline-block;"></span>
            Kontakt
          </div>
          <h2 class="kontakt-heading">Låt oss prata.</h2>
          <p class="kontakt-lead">
            Låt oss prata om hur jag kan få IT och automation att fungera tillsammans hos er. Carlboms Data är baserat i Lund, men bygger integrationer oavsett var ni befinner er.
          </p>

          <div class="kontakt-info">
            <a href="mailto:hello@carlbomsdata.se" class="kontakt-row">
              <span class="kontakt-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <span class="kontakt-row-text">
                <span class="kontakt-label">E-post</span>
                <span class="kontakt-value">hello@carlbomsdata.se</span>
              </span>
            </a>
            <div class="kontakt-row" style="cursor:default;">
              <span class="kontakt-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="kontakt-row-text">
                <span class="kontakt-label">Plats</span>
                <span class="kontakt-value">Lund, Sverige.</span>
              </span>
            </div>
          </div>
        </div>

        <form class="kontakt-form" id="kontakt-form">
          <div class="form-header">
            <h3 style="font:600 22px/1.2 var(--font-sans);letter-spacing:-0.02em;color:var(--color-ink);margin:0 0 6px;">
              Beskriv er utmaning.
            </h3>
            <p style="font:400 14px/20px var(--font-sans);color:var(--color-body);margin:0;">
              Så hör jag av mig för ett förutsättningslöst rådgivningsmöte.
            </p>
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label for="k-namn">Namn *</label>
              <input type="text" id="k-namn" name="namn" required />
            </div>
            <div class="form-field">
              <label for="k-foretag">Företag</label>
              <input type="text" id="k-foretag" name="foretag" />
            </div>
          </div>
          <div class="form-field">
            <label for="k-email">E-post *</label>
            <input type="email" id="k-email" name="email" required />
          </div>
          <div class="form-field">
            <label for="k-meddelande">Vad behöver ni hjälp med? *</label>
            <textarea id="k-meddelande" name="meddelande" required placeholder="T.ex. &quot;PLC pratar inte med affärssystemet. Vi tappar rapportdata.&quot;"></textarea>
          </div>
          <input type="text" name="website" style="position:absolute;left:-9999px;opacity:0;height:0;" tabindex="-1" autocomplete="off" />

          <button type="submit" class="form-submit" id="kontakt-submit">
            <span class="submit-label">Skicka — låt oss prata
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
            <span class="submit-sending" style="display:none;">Skickar…</span>
          </button>

          <div class="form-status form-success" id="form-success" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Tack! Jag hör av mig inom kort.
          </div>
          <div class="form-status form-error" id="form-error" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
            Något gick fel. Försök igen eller maila <a href="mailto:hello@carlbomsdata.se">hello@carlbomsdata.se</a>.
          </div>

          <div class="form-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Er data stannar hos mig. Inga tredjeparter, inga nyhetsbrev.
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  section[id] { scroll-margin-top: 80px; }

  /* Hero */
  .hero-section { position: relative; overflow: hidden; }
  .hero-backdrop { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero-gradient {
    position: absolute; inset: 0;
    background:
      radial-gradient(at 50% -10%, rgba(22,176,121,0.18) 0%, transparent 55%),
      radial-gradient(at 85% 40%, rgba(0,124,240,0.10) 0%, transparent 50%),
      radial-gradient(at 15% 60%, rgba(22,176,121,0.10) 0%, transparent 55%);
  }
  .hero-grid-texture {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(0,0,0,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at 50% 35%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 35%, #000 25%, transparent 75%);
  }
  .hero-content { position: relative; z-index: 1; padding-top: 104px; padding-bottom: 80px; }
  .hero-center { text-align: center; max-width: 920px; margin: 0 auto; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; margin-top: 36px; flex-wrap: wrap; }
  @media (max-width: 640px) {
    .hero-content { padding-top: 64px; padding-bottom: 56px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .cta { justify-content: center; height: 48px; font-size: 15px; padding: 0 20px; }
  }

  .section-intro { max-width: 720px; margin: 0 auto 48px; text-align: center; }
  .section-intro .eyebrow { justify-content: center; }
  @media (max-width: 640px) { .section-intro { margin-bottom: 32px; } }

  .chip {
    display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 100px;
    background: var(--color-canvas-soft); font: 400 12px/16px var(--font-mono);
    color: var(--color-body); box-shadow: inset 0 0 0 1px var(--color-hairline); white-space: nowrap;
  }

  /* Tjänster */
  .tjanst-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 980px) { .tjanst-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .tjanst-grid { grid-template-columns: 1fr; } }
  .tjanst-card { padding: 24px; display: flex; flex-direction: column; }
  .tjanst-head { display: flex; align-items: center; justify-content: space-between; }
  .tjanst-icon {
    width: 40px; height: 40px; border-radius: 10px;
    background: linear-gradient(180deg, #f0fdf4 0%, #d6f5e6 100%); color: #0e7a55;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 1px rgba(14,122,85,0.18);
  }
  .tjanst-num { font: 400 11px/16px var(--font-mono); color: var(--color-mute); letter-spacing: 0.08em; }
  .tjanst-body { margin: 8px 0 0; color: var(--color-body); font-size: 14px; line-height: 1.55; flex: 1; }
  .tjanst-chips { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 6px; }

  /* Varför Carlboms Data — hairline-separerad lista, inte ännu ett kortgrid */
  .fordel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 64px;
  }
  .fordel {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 24px 0;
    border-top: 1px solid var(--color-hairline);
  }
  .fordel-icon {
    flex-shrink: 0;
    width: 28px; height: 28px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    background: linear-gradient(180deg, #f0fdf4 0%, #d6f5e6 100%);
    color: #0e7a55;
    box-shadow: inset 0 0 0 1px rgba(14,122,85,0.18);
  }
  .fordel-title {
    font: 600 17px/1.3 var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 3px 0 0;
  }
  .fordel-body {
    font: 400 14px/1.55 var(--font-sans);
    color: var(--color-body);
    margin: 6px 0 0;
    max-width: 42ch;
  }
  @media (max-width: 880px) {
    .fordel-grid { gap: 0 40px; }
  }
  @media (max-width: 640px) {
    .fordel-grid { grid-template-columns: 1fr; }
    .fordel { padding: 20px 0; }
  }

  /* Referenser — projekt (Utmaning / Lösning / Resultat) */
  .cases-stack { display: grid; gap: 0; }
  .case-card {
    padding: 48px 0; border-top: 1px solid var(--color-hairline);
    display: grid; grid-template-columns: 300px 1fr; gap: 64px; align-items: start;
  }
  .case-card:last-child { border-bottom: 1px solid var(--color-hairline); }
  .case-left { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 20px; }
  .case-meta {
    font: 400 11px/16px var(--font-mono); color: var(--color-mute); letter-spacing: 0.1em;
    text-transform: uppercase; display: flex; align-items: center; gap: 8px; white-space: nowrap;
