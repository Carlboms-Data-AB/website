    .kontakt-value { font-size: 14px; }
  }
</style>

<script>
  const FORM_API = "https://carlbomsdata-form-submission.anvil.app/_/api/contact";

  document.getElementById("kontakt-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const btn = document.getElementById("kontakt-submit") as HTMLButtonElement;
    const successEl = document.getElementById("form-success") as HTMLElement;
    const errorEl = document.getElementById("form-error") as HTMLElement;

    successEl.style.display = "none";
    errorEl.style.display = "none";
    btn.disabled = true;
    (btn.querySelector(".submit-label") as HTMLElement).style.display = "none";
    (btn.querySelector(".submit-sending") as HTMLElement).style.display = "inline";

    try {
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch(FORM_API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(res.statusText);
      form.reset();
      successEl.style.display = "inline-flex";
    } catch {
      errorEl.style.display = "inline-flex";
    } finally {
      btn.disabled = false;
      (btn.querySelector(".submit-label") as HTMLElement).style.display = "inline-flex";
      (btn.querySelector(".submit-sending") as HTMLElement).style.display = "none";
    }
  });
</script>
