---
/**
 * Not found. Identical in both repositories — the words come from the copy
 * object, and the title is swapped in rather than written a second time.
 */
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { url } from '~/site';
import { copy } from '~/copy';

const base = copy.sv;
const t = { ...base, meta: { ...base.meta, title: base.notFound.title } };
---

<Base t={t} noindex>
  <Nav t={t} />
  <main>
    <section class="section notfound">
      <div class="container notfound-inner">
        <div class="notfound-code">{t.notFound.code}</div>
        <h1 class="notfound-title">{t.notFound.title}</h1>
        <p class="notfound-body">{t.notFound.body}</p>
        <a class="cta" href={url(t.home)}>{t.notFound.cta}</a>
      </div>
    </section>
  </main>
  <Footer t={t} />
</Base>
