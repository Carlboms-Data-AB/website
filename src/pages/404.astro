---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Sidan kunde inte hittas',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="section" style="min-height:60vh;display:flex;align-items:center;">
    <div class="container" style="text-align:center;max-width:520px;margin:0 auto;">
      <div style="font:600 96px/1 var(--font-sans);color:var(--color-hairline-strong);letter-spacing:-0.04em;">404</div>
      <h1 style="font:600 28px/1.2 var(--font-sans);letter-spacing:-0.02em;margin:24px 0 12px;color:var(--color-ink);">
        Sidan kunde inte hittas.
      </h1>
      <p style="font:400 16px/1.55 var(--font-sans);color:var(--color-body);margin:0 0 32px;">
        Sidan du letade efter finns inte längre eller har flyttats.
      </p>
      <a href="/" class="cta">Tillbaka till startsidan</a>
    </div>
  </section>
</Layout>
