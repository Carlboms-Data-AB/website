---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { url } from '~/site';
import { copy, FORM_API, SOURCE } from '~/copy';

const base = copy.sv;
const t = {
  ...base,
  meta: { ...base.meta, title: 'Verktyg – Carlboms Data AB' },
  nav: { ...base.nav, links: [], ctaHref: `${url('/')}#kontakt` },
};

const DL = 'https://github.com/Carlboms-Data-AB/downloads/releases/download';

const webApps = [
  {
    name: 'Freeze Detector',
    src: '/verktyg/freeze/',
    body:
      'Hittar frysningar i en skärminspelning — de sekunder då bilden står helt ' +
      'still. Ladda in en MP4, markera kameraytan och få en tidslinje och en ' +
      'lista över varje frys.',
    shots: ['/verktyg/shots/freeze-detector/1.png'],
  },
  {
    name: 'Parcel Cropper',
    src: '/verktyg/parcel/',
    body:
      'Beskär fraktsedeln ur en PostNord- eller Tradera-PDF och sparar etiketten ' +
      'i rätt storlek (104,4 × 187,8 mm) för etikettskrivare. Text och streckkod ' +
      'behålls som vektor och förblir skarpa.',
    code: 'https://github.com/Carlboms-Data-AB/postnord-parcel-cropper',
    shots: ['/verktyg/shots/parcel-cropper/1.png'],
  },
  {
    name: 'Pneumatic Calculator',
    src: '/verktyg/pneumatic/',
    body:
      'Räknar på dubbelverkande pneumatikcylindrar: kraft, erforderligt tryck, ' +
      'cylinderdiameter (ISO 15552) och luftförbrukning. Stöder bar, psi, kPa och MPa.',
    code: 'https://github.com/Carlboms-Data-AB/pneumatic-calculator',
    shots: ['/verktyg/shots/pneumatic-calculator/1.png'],
  },
  {
    name: 'Network Tools',
    href: 'https://network-tools.anvil.app',
    body:
      'Portscanner och DNS-koll i webbläsaren — se om portar är öppna på en värd ' +
      'och hur DNS-poster har spridit sig mellan namnservrar.',
    shots: ['/verktyg/shots/network-tools/1.png'],
  },
];

const programs = [
  {
    name: 'FlamingoDoctor',
    href: `${DL}/flamingodoctor/FlamingoDoctor.zip`,
    body:
      'Diagnostikverktyg för Flamingo-luppkameran från Ergoluppar AB. Kör en ' +
      'rad kontroller — kamerans nåbarhet, nätverkskort med mera — och ' +
      'sammanfattar resultatet för snabb felsökning av frysningar och nätverk.',
  },
  {
    name: 'vhdx2vmdk',
    href: `${DL}/vhdx2vmdk/vhdx2vmdk.exe`,
    body:
      'Konverterar Hyper-V VHDX-diskar till VMware VMDK. Ett enkelt gränssnitt ' +
      'runt qemu-img, med stöd för att konvertera flera filer i batch.',
  },
  {
    name: 'disk2vhd',
    href: `${DL}/disk2vhd/Disk2vhd.zip`,
    body:
      'Avbildar en fysisk disk till en VHD-fil — första steget när en fysisk ' +
      'maskin ska virtualiseras.',
  },
  {
    name: 'qemu-img',
    href: `${DL}/qemu-img-windows-x64/qemu-img-windows-x64-v10.0.0.zip`,
    body:
      'Kör qemu-img på Windows utan att installera hela QEMU. Konverterar och ' +
      'inspekterar diskavbilder i format som qcow2, vmdk, vhdx och raw.',
    code: 'https://github.com/Carlboms-Data-AB/qemu-img-windows-x64',
  },
  {
    name: 'chm2txt',
    href: `${DL}/chm2txt/chm2txt-v3.0.0-win.zip`,
    body: 'Extraherar innehållet ur CHM-hjälpfiler till ren, sökbar text.',
  },
  {
    name: 'Glass Kiosk',
    href: `${DL}/glass-kiosk/GlassKiosk.zip`,
    body:
      'Kiosk-webbläsare för Windows. Låser en dator till en enda webbsida, med ' +
      'autostart, dold verktygsrad och lösenordsskydd.',
    code: 'https://github.com/Carlboms-Data-AB/Glass-Kiosk-Desktop',
  },
  {
    name: 'terminal-banner',
    link: 'https://github.com/Carlboms-Data-AB/terminal-banner',
    body: 'Färgglad inloggningsbanner (MOTD) för Linux. Öppen källkod på GitHub.',
  },
];

const licensed = [
  {
    name: 'Rowmantic Print',
    body:
      'Komplett system för etikettutskrift i produktion: en designer för att ' +
      'rita etiketter, en utskriftstjänst och ett administrationsverktyg.',
  },
  {
    name: 'OpcLogger',
    body:
      'OPC DA-gateway för KepServerEX. Körs som en Windows-tjänst som läser alla ' +
      'taggar och vidarebefordrar dem till e-post, SQL, webhook, MQTT eller ' +
      'InfluxDB, med en app för konfiguration och övervakning.',
  },
  {
    name: 'e-designer2citect',
    body:
      'Migrerar Beijer E-Designer-projekt till Citect och automatiserar en ' +
      'annars manuell och tidsödande överföring.',
  },
  {
    name: 'e-designer-extracter',
    body:
      'Extraherar innehållet ur Beijer E-Designer-projekt för granskning och ' +
      'vidare bearbetning.',
  },
  {
    name: 'dbf-editor',
    body:
      'DBF-editor för CitectSCADA. Öppnar och redigerar dBASE III-filer med ' +
      'automatisk backup och svensk teckenkodning — en enda liten exe utan ' +
      'installation, från Windows XP till 11.',
  },
  {
    name: 'pdf2png',
    body:
      'Konverterar PDF-sidor till PNG-bilder, en bild per sida — för när du ' +
      'snabbt behöver sidorna som bild i stället för PDF.',
  },
  {
    name: 'dwg2pdf',
    body:
      'Konverterar AutoCAD DWG-ritningar till PDF med bibehållen ' +
      'vektorkvalitet. Fristående — inga andra program behövs.',
  },
];
---

<Base t={t} noindex>
  <Nav t={t} />
  <main>
    <section class="section">
      <div class="container tools-page">
        <h1 class="tools-title">Verktyg</h1>
        <p class="tools-lead">
          Egenutvecklade webb- och desktopverktyg för analys, felsökning,
          testning och konvertering.
        </p>

        <h2 class="tools-section">Webbappar</h2>
        <ul class="tools-list">
          {
            webApps.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  {tool.src ? (
                    <button class="cta tool-open" type="button" data-src={url(tool.src)} data-name={tool.name}>
                      Öppna
                    </button>
                  ) : (
                    <a class="cta" href={tool.href} target="_blank" rel="noopener noreferrer">
                      Öppna ↗
                    </a>
                  )}
                  {tool.code && (
                    <a class="cta secondary" href={tool.code} target="_blank" rel="noopener noreferrer">
                      Källkod ↗
                    </a>
                  )}
                  {tool.shots && (
                    <button
                      class="cta secondary shots-open"
                      type="button"
                      data-shots={JSON.stringify(tool.shots.map((s) => url(s)))}
                    >
                      Bilder
                    </button>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="tools-section">Program</h2>
        <ul class="tools-list">
          {
            programs.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  {tool.href ? (
                    <a class="cta" href={tool.href}>Ladda ner</a>
                  ) : (
                    <a class="cta secondary" href={tool.link} target="_blank" rel="noopener noreferrer">
                      Öppna på GitHub ↗
                    </a>
                  )}
                  {tool.code && (
                    <a class="cta secondary" href={tool.code} target="_blank" rel="noopener noreferrer">
                      Källkod ↗
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="tools-section">Kommersiellt</h2>
        <ul class="tools-list">
          {
            licensed.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  <button class="cta" type="button" disabled>Beställ licens</button>
                  <button class="cta secondary demo-open" type="button" data-tool={tool.name}>
                    Boka demo
                  </button>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer t={t} />

  <div id="toolModal" class="tool-modal" hidden>
    <div class="tool-modal-bar">
      <button id="toolModalClose" class="tool-modal-close" type="button">Stäng ✕</button>
    </div>
    <iframe id="toolModalFrame" title=""></iframe>
  </div>

  <div id="demoModal" class="demo-modal" hidden>
    <div class="demo-backdrop" data-close></div>
    <div class="demo-dialog" role="dialog" aria-modal="true" aria-labelledby="demoTitle">
      <button class="demo-close" type="button" data-close aria-label="Stäng">✕</button>
      <h2 id="demoTitle" class="demo-title">Boka demo</h2>
      <p class="demo-sub" id="demoSub"></p>
      <form id="demoForm" class="demo-form" data-endpoint={FORM_API} data-source={SOURCE}>
        <div class="demo-field">
          <label for="demoNamn">Namn *</label>
          <input id="demoNamn" name="namn" type="text" required maxlength="200" autocomplete="name" />
        </div>
        <div class="demo-field">
          <label for="demoEmail">E-post *</label>
          <input id="demoEmail" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="demo-field">
          <label for="demoMsg">Meddelande *</label>
          <textarea id="demoMsg" name="meddelande" required maxlength="5000"></textarea>
        </div>
        <input
          type="text"
          name="website"
          class="demo-honeypot"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit" class="cta demo-submit" id="demoSubmit">
          <span class="demo-submit-label">Skicka demoförfrågan</span>
          <span class="demo-submit-sending" hidden>Skickar …</span>
        </button>
        <div class="demo-status demo-success" id="demoSuccess" role="status" hidden>
          Tack! Vi hör av oss inom kort.
        </div>
        <div class="demo-status demo-error" id="demoError" role="alert" hidden>
          Något gick fel — mejla <a href="mailto:hello@carlbomsdata.se">hello@carlbomsdata.se</a>.
        </div>
      </form>
    </div>
  </div>

  <div id="shotModal" class="shot-modal" hidden>
    <div class="shot-backdrop" data-close></div>
    <button id="shotClose" class="shot-close" type="button" data-close aria-label="Stäng">✕</button>
    <button id="shotPrev" class="shot-nav shot-prev" type="button" aria-label="Föregående" hidden>‹</button>
    <img id="shotImg" class="shot-img" alt="" />
    <button id="shotNext" class="shot-nav shot-next" type="button" aria-label="Nästa" hidden>›</button>
    <span id="shotCount" class="shot-count"></span>
  </div>
</Base>

<style>
  .tools-page {
    max-width: 840px;
  }
  .tools-title {
    font: 600 34px/1.1 var(--font-sans);
    letter-spacing: -0.5px;
    margin: 0 0 12px;
  }
  .tools-lead {
    color: var(--color-body);
    max-width: 62ch;
    margin: 0 0 40px;
  }
  .tools-section {
    font: 400 12px/16px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted, #666);
    margin: 44px 0 16px;
  }
  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .tool-card {
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    border-radius: 16px;
    padding: 24px;
    background: var(--color-canvas-soft, #fff);
  }
  .tool-name {
    font: 600 20px/1.2 var(--font-sans);
    margin: 0;
  }
  .tool-body {
    color: var(--color-body);
    margin: 12px 0 20px;
    max-width: 62ch;
  }
  .tool-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cta[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .tool-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  .tool-modal-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    background: var(--color-canvas-soft, #f6f6f6);
  }
  .tool-modal-close {
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.15));
    border-radius: 100px;
    background: #fff;
    color: var(--color-ink, #111);
    font: 500 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .tool-modal-close:hover {
    background: var(--color-canvas-soft, #eee);
  }
  .tool-modal iframe {
    flex: 1;
    width: 100%;
    border: 0;
    background: #fff;
  }

  .demo-modal {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .demo-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  .demo-dialog {
    position: relative;
    z-index: 1;
    width: min(480px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: var(--color-canvas, #fff);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
  }
  .demo-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 100px;
    background: transparent;
    color: var(--color-muted, #666);
    font-size: 15px;
    cursor: pointer;
  }
  .demo-close:hover {
    background: var(--color-canvas-soft, #eee);
    color: var(--color-ink, #111);
  }
  .demo-title {
    font: 600 22px/1.2 var(--font-sans);
    margin: 0 0 4px;
  }
  .demo-sub {
    color: var(--color-muted, #666);
    margin: 0 0 20px;
    font: 400 13px/1.4 var(--font-mono);
  }
  .demo-form {
    display: grid;
    gap: 14px;
  }
  .demo-field {
    display: grid;
    gap: 6px;
  }
  .demo-field label {
    font: 500 13px/1 var(--font-sans);
    color: var(--color-body);
  }
  .demo-field input,
  .demo-field textarea {
    font: inherit;
    padding: 10px 12px;
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.15));
    border-radius: 8px;
    background: #fff;
    color: var(--color-ink, #111);
  }
  .demo-field textarea {
    min-height: 90px;
    resize: vertical;
  }
  .demo-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .demo-submit {
    margin-top: 4px;
    justify-content: center;
  }
  .demo-status {
    font-size: 14px;
    margin: 0;
  }
  .demo-success {
    color: var(--accent-deep, #0e7a55);
  }
  .demo-error {
    color: #b91c1c;
  }
  .shot-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  .shot-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }
  .shot-img {
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .shot-close,
  .shot-nav {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
  }
  .shot-close:hover,
  .shot-nav:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  .shot-close {
    top: 16px;
    right: 20px;
    width: 40px;
    height: 40px;
    font-size: 16px;
  }
  .shot-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 28px;
  }
  .shot-prev {
    left: 16px;
  }
  .shot-next {
    right: 16px;
  }
  .shot-count {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255, 255, 255, 0.8);
    font: 400 13px/1 var(--font-mono);
  }
</style>

<script>
  const modal = document.getElementById('toolModal') as HTMLElement | null;
  const frame = document.getElementById('toolModalFrame') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('toolModalClose');

  const close = () => {
    if (!modal || !frame) return;
    modal.hidden = true;
    frame.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('.tool-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modal || !frame) return;
      const src = btn.dataset.src;
      const name = btn.dataset.name || '';
      if (!src) return;
      frame.src = src;
      frame.title = name;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) close();
  });

  const demoModal = document.getElementById('demoModal') as HTMLElement | null;
  const demoForm = document.getElementById('demoForm') as HTMLFormElement | null;
  const demoSub = document.getElementById('demoSub');
  const demoMsg = document.getElementById('demoMsg') as HTMLTextAreaElement | null;
  let demoTool = '';

  const openDemo = (t: string) => {
    if (!demoModal) return;
    demoTool = t;
    if (demoSub) demoSub.textContent = t;
    if (demoMsg) demoMsg.value = `Jag vill boka en demo av ${t}.`;
    document.getElementById('demoSuccess')?.setAttribute('hidden', '');
    document.getElementById('demoError')?.setAttribute('hidden', '');
    demoModal.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('demoNamn')?.focus();
  };
  const closeDemo = () => {
    if (!demoModal) return;
    demoModal.hidden = true;
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('.demo-open').forEach((btn) => {
    btn.addEventListener('click', () => openDemo(btn.dataset.tool || ''));
  });
  demoModal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeDemo));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && demoModal && !demoModal.hidden) closeDemo();
  });

  demoForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = document.getElementById('demoSubmit') as HTMLButtonElement;
    const label = button.querySelector('.demo-submit-label') as HTMLElement;
    const sending = button.querySelector('.demo-submit-sending') as HTMLElement;
    const success = document.getElementById('demoSuccess') as HTMLElement;
    const error = document.getElementById('demoError') as HTMLElement;

    success.hidden = true;
    error.hidden = true;
    button.disabled = true;
    label.hidden = true;
    sending.hidden = false;

    try {
      const data = Object.fromEntries(new FormData(demoForm)) as Record<string, string>;
      data.source = `${demoForm.dataset.source ?? ''} · demo: ${demoTool}`;
      const response = await fetch(demoForm.dataset.endpoint ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!response.ok) throw new Error(response.statusText);
      demoForm.reset();
      success.hidden = false;
    } catch {
      error.hidden = false;
    } finally {
      button.disabled = false;
      label.hidden = false;
      sending.hidden = true;
    }
  });
  const shotModal = document.getElementById('shotModal') as HTMLElement | null;
  const shotImg = document.getElementById('shotImg') as HTMLImageElement | null;
  const shotPrev = document.getElementById('shotPrev') as HTMLElement | null;
  const shotNext = document.getElementById('shotNext') as HTMLElement | null;
  const shotCount = document.getElementById('shotCount');
  let shotList: string[] = [];
  let shotIdx = 0;

  const renderShot = () => {
    if (!shotImg) return;
    shotImg.src = shotList[shotIdx] || '';
    const multi = shotList.length > 1;
    if (shotCount) shotCount.textContent = multi ? `${shotIdx + 1} / ${shotList.length}` : '';
    if (shotPrev) shotPrev.hidden = !multi;
    if (shotNext) shotNext.hidden = !multi;
  };
  const stepShot = (d: number) => {
    if (!shotList.length) return;
    shotIdx = (shotIdx + d + shotList.length) % shotList.length;
    renderShot();
  };
  const openShots = (list: string[]) => {
    if (!shotModal || !list.length) return;
    shotList = list;
    shotIdx = 0;
    renderShot();
    shotModal.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const closeShots = () => {
    if (!shotModal) return;
    shotModal.hidden = true;
    shotImg?.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('.shots-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        openShots(JSON.parse(btn.dataset.shots || '[]'));
      } catch {
        /* ignore malformed data */
      }
    });
  });
  shotPrev?.addEventListener('click', () => stepShot(-1));
  shotNext?.addEventListener('click', () => stepShot(1));
  shotModal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeShots));
  document.addEventListener('keydown', (e) => {
    if (!shotModal || shotModal.hidden) return;
    if (e.key === 'Escape') closeShots();
    if (e.key === 'ArrowLeft') stepShot(-1);
    if (e.key === 'ArrowRight') stepShot(1);
  });
</script>
