---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { url } from '~/site';
import { copy } from '~/copy';

const base = copy.sv;
const t = {
  ...base,
  meta: { ...base.meta, title: 'Verktyg – Carlboms Data AB' },
  nav: { ...base.nav, links: [], ctaHref: `${url('/')}#kontakt` },
};

const DL = 'https://github.com/Carlboms-Data-AB/downloads/releases/download';
const demoHref = `${url('/')}#kontakt`;

const webApps = [
  {
    name: 'Freeze Detector',
    src: '/verktyg/freeze/',
    body:
      'Hittar frysningar i en skärminspelning — sekunderna då bilden står helt ' +
      'still. Välj en MP4, markera kameraytan, och få en tidslinje och en lista ' +
      'över varje frys att klicka dig igenom.',
  },
  {
    name: 'Parcel Cropper',
    src: '/verktyg/parcel/',
    body:
      'Beskär fraktsedeln ur en PostNord- eller Tradera-PDF och sparar etiketten ' +
      'i rätt storlek, 104,4 × 187,8 mm, för en etikettskrivare. Text och ' +
      'streckkod behålls som vektor och förblir skarpa.',
    code: 'https://github.com/Carlboms-Data-AB/postnord-parcel-cropper',
  },
  {
    name: 'Pneumatic Calculator',
    src: '/verktyg/pneumatic/',
    body:
      'Räknar på dubbelverkande pneumatikcylindrar — kraft, erforderligt tryck, ' +
      'dimensionering av cylinderdiameter (ISO 15552) och luftförbrukning. ' +
      'Enheter i bar, psi, kPa och MPa.',
    code: 'https://github.com/Carlboms-Data-AB/pneumatic-calculator',
  },
];

const programs = [
  {
    name: 'FlamingoDoctor',
    plat: 'Windows',
    href: `${DL}/flamingodoctor/FlamingoDoctor.zip`,
    body:
      'Diagnostik för kamera och nätverk — kontrollerar nåbarhet, nätverkskort ' +
      'med mera och ger en samlad sammanfattning. Bra vid felsökning av ' +
      'frysningar och nätverk.',
  },
  {
    name: 'vhdx2vmdk',
    plat: 'Windows',
    href: `${DL}/vhdx2vmdk/vhdx2vmdk.exe`,
    body:
      'Batchkonverterar Hyper-V VHDX-diskar till VMware VMDK. Ett enkelt ' +
      'gränssnitt runt qemu-img — peka ut filerna och konvertera flera på en gång.',
  },
  {
    name: 'disk2vhd',
    plat: 'Windows',
    href: `${DL}/disk2vhd/Disk2vhd.zip`,
    body:
      'Avbildar en fysisk disk till en VHD-fil. Första steget när en fysisk ' +
      'maskin ska flyttas in i en virtuell.',
  },
  {
    name: 'qemu-img',
    plat: 'Windows',
    href: `${DL}/qemu-img-windows-x64/qemu-img-windows-x64-v10.0.0.zip`,
    body:
      'Kör qemu-img på Windows utan att installera hela QEMU. Konverterar och ' +
      'inspekterar diskavbilder — qcow2, vmdk, vhdx, raw med flera.',
    code: 'https://github.com/Carlboms-Data-AB/qemu-img-windows-x64',
  },
  {
    name: 'chm2txt',
    plat: 'Windows',
    href: `${DL}/chm2txt/chm2txt-v3.0.0-win.zip`,
    body:
      'Extraherar texten ur CHM-hjälpfiler till ren text. Använder Windows ' +
      'inbyggda hh.exe för att packa upp och rensar sedan bort HTML.',
  },
  {
    name: 'Glass Kiosk',
    plat: 'Windows',
    href: `${DL}/glass-kiosk/GlassKiosk.zip`,
    body:
      'Lättviktig kiosk-webbläsare för Windows (WebView2). Lås datorn till en ' +
      'webbsida med autostart, dold verktygsrad och lösenordsskydd.',
    code: 'https://github.com/Carlboms-Data-AB/Glass-Kiosk-Desktop',
  },
  {
    name: 'terminal-banner',
    plat: 'Linux',
    link: 'https://github.com/Carlboms-Data-AB/terminal-banner',
    body:
      'Färgglad inloggningsbanner (MOTD) för Linux som visas vid inloggning. ' +
      'Öppen källkod — hela skriptet finns på GitHub.',
  },
];

const licensed = [
  {
    name: 'Rowmantic Print',
    plat: 'Windows',
    body:
      'Komplett system för etikettutskrift i produktion — en designer för att ' +
      'rita etiketter, en tjänst som sköter utskrifterna och ett administrationsverktyg.',
  },
  {
    name: 'OpcLogger',
    plat: 'Windows',
    body:
      'OPC DA-gateway för KepServerEX. Körs som en headless Windows-tjänst, ' +
      'prenumererar automatiskt på alla taggar och kan agera via e-post, SQL, ' +
      'webhook, MQTT och InfluxDB — med en WPF-app för att styra den.',
  },
  {
    name: 'e-designer2citect',
    plat: 'Windows',
    body:
      'Migrerar Beijer E-Designer-projekt till Citect. Automatiserar en annars ' +
      'manuell och tidsödande överföring.',
  },
  {
    name: 'e-designer-extracter',
    plat: 'Windows',
    body:
      'Extraherar innehållet ur Beijer E-Designer-projekt för granskning och ' +
      'vidare bearbetning.',
  },
  {
    name: 'dbf-editor',
    plat: 'Windows',
    body:
      'Lättviktig DBF-editor för CitectSCADA — öppnar och redigerar dBASE III-' +
      'filer med automatisk backup och svensk teckenkodning. En enda liten exe ' +
      'utan installation, från Windows XP till 11.',
  },
  {
    name: 'pdf2png',
    plat: 'Windows',
    body:
      'Konverterar PDF-sidor till PNG-bilder, en bild per sida. För när du ' +
      'snabbt behöver sidorna som bilder i stället för PDF.',
  },
];
---

<Base t={t} noindex>
  <Nav t={t} />
  <main>
    <section class="section">
      <div class="container tools-page">
        <h1 class="tools-title">Verktyg</h1>
        <p class="tools-lead">
          Egenutvecklade webb- och desktopverktyg för analys, felsökning,
          testning och konvertering.
        </p>

        <h2 class="tools-section">Webbappar</h2>
        <ul class="tools-list">
          {
            webApps.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  <button class="cta tool-open" type="button" data-src={url(tool.src)} data-name={tool.name}>
                    Öppna
                  </button>
                  {tool.code && (
                    <a class="cta secondary" href={tool.code} target="_blank" rel="noopener noreferrer">
                      Källkod ↗
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="tools-section">Program</h2>
        <ul class="tools-list">
          {
            programs.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  {tool.href ? (
                    <a class="cta" href={tool.href}>Ladda ner</a>
                  ) : (
                    <a class="cta secondary" href={tool.link} target="_blank" rel="noopener noreferrer">
                      Öppna på GitHub ↗
                    </a>
                  )}
                  {tool.code && (
                    <a class="cta secondary" href={tool.code} target="_blank" rel="noopener noreferrer">
                      Källkod ↗
                    </a>
                  )}
                  {tool.plat && <span class="tool-plat">{tool.plat}</span>}
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="tools-section">Kommersiellt</h2>
        <ul class="tools-list">
          {
            licensed.map((tool) => (
              <li class="tool-card">
                <h3 class="tool-name">{tool.name}</h3>
                <p class="tool-body">{tool.body}</p>
                <div class="tool-foot">
                  <button class="cta" type="button" disabled>Beställ licens</button>
                  <a class="cta secondary" href={demoHref}>Boka demo</a>
                  {tool.plat && <span class="tool-plat">{tool.plat}</span>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer t={t} />

  <div id="toolModal" class="tool-modal" hidden>
    <div class="tool-modal-bar">
      <button id="toolModalClose" class="tool-modal-close" type="button">Stäng ✕</button>
    </div>
    <iframe id="toolModalFrame" title=""></iframe>
  </div>
</Base>

<style>
  .tools-page {
    max-width: 840px;
  }
  .tools-title {
    font: 600 34px/1.1 var(--font-sans);
    letter-spacing: -0.5px;
    margin: 0 0 12px;
  }
  .tools-lead {
    color: var(--color-body);
    max-width: 62ch;
    margin: 0 0 40px;
  }
  .tools-section {
    font: 400 12px/16px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted, #666);
    margin: 44px 0 16px;
  }
  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .tool-card {
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    border-radius: 16px;
    padding: 24px;
    background: var(--color-canvas-soft, #fff);
  }
  .tool-name {
    font: 600 20px/1.2 var(--font-sans);
    margin: 0;
  }
  .tool-body {
    color: var(--color-body);
    margin: 12px 0 20px;
    max-width: 62ch;
  }
  .tool-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .tool-plat {
    margin-left: auto;
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--color-muted, #666);
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.12));
    border-radius: 100px;
    padding: 5px 10px;
  }
  .cta[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .tool-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  .tool-modal-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    background: var(--color-canvas-soft, #f6f6f6);
  }
  .tool-modal-close {
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.15));
    border-radius: 100px;
    background: #fff;
    color: var(--color-ink, #111);
    font: 500 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .tool-modal-close:hover {
    background: var(--color-canvas-soft, #eee);
  }
  .tool-modal iframe {
    flex: 1;
    width: 100%;
    border: 0;
    background: #fff;
  }
</style>

<script>
  const modal = document.getElementById('toolModal') as HTMLElement | null;
  const frame = document.getElementById('toolModalFrame') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('toolModalClose');

  const close = () => {
    if (!modal || !frame) return;
    modal.hidden = true;
    frame.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('.tool-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modal || !frame) return;
      const src = btn.dataset.src;
      const name = btn.dataset.name || '';
      if (!src) return;
      frame.src = src;
      frame.title = name;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) close();
  });
</script>
