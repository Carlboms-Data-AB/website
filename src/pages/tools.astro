---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import { url } from '~/site';
import { copy } from '~/copy';

const base = copy.sv;
const t = {
  ...base,
  meta: { ...base.meta, title: 'Verktyg – Carlboms Data AB' },
  nav: { ...base.nav, links: [], ctaHref: `${url('/')}#kontakt` },
};

const tools = [
  {
    name: 'Freeze Detector',
    src: '/verktyg/freeze/',
    body:
      'Hittar frysningar i en skärminspelning — sekunderna då bilden står helt ' +
      'still. Välj en MP4, markera kameraytan, och få en tidslinje och en ' +
      'lista över varje frys att klicka dig igenom.',
  },
  {
    name: 'Parcel Cropper',
    src: '/verktyg/parcel/',
    body:
      'Beskär fraktsedeln ur en PostNord- eller Tradera-PDF och sparar etiketten ' +
      'i rätt storlek, 104,4 × 187,8 mm, för en etikettskrivare. Text och ' +
      'streckkod behålls som vektor och förblir skarpa.',
  },
];
---

<Base t={t} noindex>
  <Nav t={t} />
  <main>
    <section class="section">
      <div class="container tools-page">
        <h1 class="tools-title">Verktyg</h1>
        <p class="tools-lead">
          Små appar som körs helt i din webbläsare. Allt sker lokalt – inget
          skickas till någon server.
        </p>

        <ul class="tools-list">
          {
            tools.map((tool) => (
              <li class="tool-card">
                <h2 class="tool-name">{tool.name}</h2>
                <p class="tool-body">{tool.body}</p>
                <button
                  class="cta tool-open"
                  type="button"
                  data-src={url(tool.src)}
                  data-name={tool.name}
                >
                  Öppna
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer t={t} />

  <div id="toolModal" class="tool-modal" hidden>
    <div class="tool-modal-bar">
      <button id="toolModalClose" class="tool-modal-close" type="button">Stäng ✕</button>
    </div>
    <iframe id="toolModalFrame" title=""></iframe>
  </div>
</Base>

<style>
  .tools-page {
    max-width: 840px;
  }
  .tools-title {
    font: 600 34px/1.1 var(--font-sans);
    letter-spacing: -0.5px;
    margin: 0 0 12px;
  }
  .tools-lead {
    color: var(--color-body);
    max-width: 60ch;
    margin: 0 0 40px;
  }
  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  .tool-card {
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    border-radius: 16px;
    padding: 24px;
    background: var(--color-canvas-soft, #fff);
  }
  .tool-name {
    font: 600 20px/1.2 var(--font-sans);
    margin: 0;
  }
  .tool-body {
    color: var(--color-body);
    margin: 12px 0 20px;
    max-width: 62ch;
  }

  .tool-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  .tool-modal-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-line, rgba(0, 0, 0, 0.1));
    background: var(--color-canvas-soft, #f6f6f6);
  }
  .tool-modal-close {
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.15));
    border-radius: 100px;
    background: #fff;
    color: var(--color-ink, #111);
    font: 500 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .tool-modal-close:hover {
    background: var(--color-canvas-soft, #eee);
  }
  .tool-modal iframe {
    flex: 1;
    width: 100%;
    border: 0;
    background: #fff;
  }
</style>

<script>
  const modal = document.getElementById('toolModal') as HTMLElement | null;
  const frame = document.getElementById('toolModalFrame') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('toolModalClose');

  const close = () => {
    if (!modal || !frame) return;
    modal.hidden = true;
    frame.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('.tool-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modal || !frame) return;
      const src = btn.dataset.src;
      const name = btn.dataset.name || '';
      if (!src) return;
      frame.src = src;
      frame.title = name;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) close();
  });
</script>
