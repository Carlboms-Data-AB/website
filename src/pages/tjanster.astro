---
import Layout from '~/layouts/PageLayout.astro';
import CtaBand from '~/components/site/CtaBand.astro';
import { Image } from 'astro:assets';
import walkingImg from '~/assets/images/tobias-walking.jpg';

const metadata = {
  title: 'Mina tjänster',
  description: 'Sex kompetensområden: systemintegration, automation & PLC, HMI/SCADA, mjukvaruutveckling, nätverk & fjärråtkomst, felsökning & optimering.',
};

const kompetensLong = [
  { icon: 'M7 7a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 0v10m8-4a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm0 0H7', title: 'Systemintegration', body: 'Jag bygger mellanlaget som får era system att prata med varandra — API:er, databaskopplingar och middleware som håller datan i flöde.', chips: ['HTTP / REST', 'T-SQL', 'ODBC', 'Middleware'] },
  { icon: 'M5 5h14v14H5zm4-3v3m6-3v3M5 9h-3m3 6h-3m17-6h3m-3 6h3M9 22v-3m6 3v-3', title: 'Automation & PLC', body: 'Programmering och optimering av styrsystem med CODESYS — portabelt över hårdvaruplattformar, utan inlåsning hos en enda leverantör.', chips: ['CODESYS', 'Structured Text', 'J1939 CAN', 'UDP / NVL'] },
  { icon: 'M3 5h18v12H3zm5 16h8m-4-4v4', title: 'HMI, SCADA & övervakning', body: 'Operatörsgränssnitt och SCADA-lösningar som ger er full överblick. Jag jobbar med allt från WinCC och FUXA till helt egenutvecklade webbgränssnitt.', chips: ['WinCC', 'FUXA', 'Webb-HMI', 'Grafana / Flux'] },
  { icon: 'M8 7l-5 5 5 5m8-10l5 5-5 5', title: 'Mjukvaruutveckling', body: 'Skräddarsydda applikationer, backend-tjänster och databearbetning — i det språk och den miljö som passar just din utmaning.', chips: ['C# / .NET', 'Python', 'JavaScript', 'HTML / CSS'] },
  { icon: 'M12 2l8 4v6c0 5.5-3.8 10.7-8 12-4.2-1.3-8-6.5-8-12V6l8-4zm-2 10l2 2 4-4', title: 'Nätverk & fjärråtkomst', body: 'VPN, segmentering mellan IT och OT, brandväggar — och säker fjärråtkomst så att ni slipper skicka ut tekniker vid varje larm.', chips: ['WireGuard', 'VLAN', 'SSH', 'DNS'] },
  { icon: 'M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm10 18l-4-4', title: 'Felsökning & optimering', body: 'Något som inte fungerar som det ska? Jag gräver i PLC-logik, nätverk, databaser och kod tills jag hittar roten till problemet.', chips: ['Root-cause-analys', 'Prestanda', 'Kodgranskning', 'Akut support'] },
];

const sprakList = ['C# / .NET', 'Python', 'T-SQL', 'CODESYS Structured Text', 'HTML / CSS', 'JavaScript'];
const protokollList = ['J1939 CAN bus', 'Modbus', 'OPC UA', 'UDP / NVL', 'TCP', 'WireGuard', 'HTTP / REST', 'ODBC', 'SMB', 'SSH', 'DNS', 'VLAN'];

const steg = [
  { n: '01', title: 'Analys & Arkitektur', body: 'Jag börjar med att kartlägga dina system, dataflöden och befintliga gränssnitt. Sedan definierar jag var kommunikationen brister och designar en säker lösning som inte belastar dina existerande system.', icon: 'M12 2L2 12h3v8h6v-6h2v6h6v-8h3L12 2z' },
  { n: '02', title: 'Integration & Utveckling', body: 'Själva hantverket. Jag bygger den logik, de skript och de broar som krävs för att systemen ska kunna utbyta data sömlöst och autonomt.', icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z' },
  { n: '03', title: 'Stresstestning i trygg miljö', body: 'För att garantera noll stopptid verifierar och stresstestar jag alltid integrationen noggrant innan den driftsätts i din skarpa produktionsmiljö.', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
  { n: '04', title: 'Överlämning (inkl. källkod)', body: 'När relationen mellan systemen är på plats får du full dokumentation. När du anlitar Carlboms Data finns inga inlåsningseffekter. Du äger alltid lösningen och källkoden fullt ut.', icon: 'M12.89 1.45l8 4A2 2 0 0 1 22 7.24v9.53a2 2 0 0 1-1.11 1.79l-8 4a2 2 0 0 1-1.79 0l-8-4a2 2 0 0 1-1.1-1.8V7.24a2 2 0 0 1 1.11-1.79l8-4a2 2 0 0 1 1.78 0zM9 12l2 2 4-4' },
];
---

<Layout metadata={metadata} active="tjanster">
  <section class="section" style="background:var(--color-canvas);">
    <div class="container">
      <!-- Intro 2-column -->
      <div class="offer-intro-grid">
        <div>
          <div class="eyebrow"><span class="dot"></span>Mina tjänster</div>
          <h2 class="display-section" style="margin-top:14px;">
            Jag får din teknik att tala samma språk.
          </h2>
          <div class="offer-body">
            <p>När äldre maskinparker ska kopplas upp mot moderna molntjänster eller affärssystem uppstår ofta friktion och kostsamma stopp.</p>
            <p>Med Carlboms Data får du en oberoende part som bygger det mellanlager (middleware) som saknas. Som analyserar, tolkar och översätter data mellan dina maskiner (OT) och dina affärssystem (IT).</p>
            <p>Genom robust systemintegration skapar jag en stabil arkitektur där informationen flödar precis som den ska, dygnet runt.</p>
          </div>
        </div>
        <div class="offer-intro-img-wrap">
          <div class="offer-intro-img">
            <Image src={walkingImg} alt="Tobias Carlbom" width={600} height={800} style="width:100%;height:100%;object-fit:cover;display:block;" />
          </div>
          <div class="offer-intro-mono">
            <span>$ status</span><br/>
            <span style="color:var(--brand-green);">→ redo att hjälpa dig</span>
          </div>
        </div>
      </div>

      <!-- Kompetensområden -->
      <div style="margin-bottom:96px;">
        <div style="margin:0 auto 40px;text-align:center;">
          <div class="eyebrow" style="justify-content:center;"><span class="dot"></span>Mina kompetensområden</div>
        </div>

        <div class="kompetens-long">
          {kompetensLong.map((k, i) => (
            <article class="kompetens-long-card">
              <div class="kl-num">{String(i + 1).padStart(2, '0')}</div>
              <div class="kl-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={k.icon} /></svg>
              </div>
              <div class="kl-body">
                <h4 style="font:600 22px/1.2 var(--font-sans);letter-spacing:-0.02em;margin:0;color:var(--color-ink);">{k.title}</h4>
                <p style="margin-top:8px;color:var(--color-body);font-size:15px;line-height:1.6;">{k.body}</p>
                <div class="kl-chips">
                  {k.chips.map(c => <span class="kl-chip">{c}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Språk / Protokoll -->
      <div class="sprak-section">
        <div class="sprak-glow" aria-hidden="true"></div>
        <div style="position:relative;">
          <div style="margin:0 auto 40px;max-width:620px;text-align:center;">
            <div class="eyebrow" style="color:rgba(255,255,255,0.55);justify-content:center;">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--brand-green);display:inline-block;"></span>
              Språken jag talar
            </div>
            <p style="color:rgba(255,255,255,0.88);font:400 clamp(18px, 1.9vw, 22px)/1.55 var(--font-sans);letter-spacing:-0.01em;margin:20px 0 0;">
              Oavsett vilket protokoll dina system använder, ser jag till att datan struktureras och landar rätt.
            </p>
          </div>

          <div class="sprak-cols">
            <div class="sprak-col">
              <div class="sprak-col-label">Programmeringsspråk</div>
              <div class="sprak-pills">
                {sprakList.map(s => <span class="sprak-pill">{s}</span>)}
              </div>
            </div>
            <div class="sprak-col">
              <div class="sprak-col-label">Protokoll & teknologier</div>
              <div class="sprak-pills">
                {protokollList.map(s => <span class="sprak-pill">{s}</span>)}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Metod -->
      <div class="metod-section">
        <div style="margin:0 auto 56px;max-width:620px;text-align:center;">
          <div class="eyebrow" style="justify-content:center;"><span class="dot"></span>Metod</div>
          <h3 style="font:600 clamp(28px, 3.2vw, 40px)/1.1 var(--font-sans);letter-spacing:-0.03em;margin:12px 0 16px;color:var(--color-ink);">
            En beprövad process i fyra steg.
          </h3>
          <p class="lead" style="font-size:18px;">
            Så säkerställer jag att din produktion aldrig äventyras.
          </p>
        </div>

        <ol class="metod-timeline">
          {steg.map((s, i) => (
            <li class="metod-row">
              <div class="metod-rail" aria-hidden="true">
                <span class="metod-node">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
                </span>
                {i < steg.length - 1 && <span class="metod-line"></span>}
              </div>
              <div class="metod-content">
                <div class="metod-stepmeta">
                  <span class="metod-step-num">{s.n}</span>
                  <span class="metod-step-total">/ 04</span>
                </div>
                <h4 class="metod-title">{s.title}</h4>
                <p class="metod-body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Hittade du det du letade efter?"
    subheading="Är du osäker på vilken kompetens du behöver — boka ett kort rådgivningssamtal så reder vi ut det tillsammans."
    secondaryHref="/referenser"
    secondaryLabel="Se referenser"
  />
</Layout>

<style>
  .offer-intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 96px;
  }
  .offer-body {
    margin-top: 32px;
    display: grid; gap: 24px;
    max-width: 580px;
  }
  .offer-body p {
    font: 400 18px/1.85 var(--font-sans);
    color: var(--color-body);
    margin: 0;
  }
  .offer-intro-img-wrap {
    position: sticky; top: 96px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .offer-intro-img {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--elev-5);
    aspect-ratio: 3/4;
    background: var(--color-canvas-soft);
  }
  .offer-intro-mono {
    font: 400 12px/18px var(--font-mono);
    color: var(--color-mute);
    padding: 12px 16px;
    background: var(--color-canvas-soft);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .offer-intro-mono span:first-child { color: var(--color-body); }
  @media (max-width: 760px) {
    .offer-intro-grid { grid-template-columns: 1fr; gap: 40px; }
    .offer-intro-img-wrap { position: static; }
  }

  .kompetens-long {
    display: grid; gap: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .kompetens-long-card {
    display: grid;
    grid-template-columns: 64px 56px 1fr;
    gap: 24px; align-items: start;
    padding: 32px 16px;
    border-bottom: 1px solid var(--color-hairline);
    transition: background-color 200ms ease;
  }
  .kompetens-long-card:hover { background: var(--color-canvas-soft); }
  .kl-num {
    font: 400 12px/16px var(--font-mono);
    color: var(--color-mute);
    letter-spacing: 0.08em;
    padding-top: 6px;
  }
  .kl-icon {
    width: 48px; height: 48px; border-radius: 12px;
    background: linear-gradient(180deg, #f0fdf4 0%, #d6f5e6 100%);
    color: #0e7a55;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 1px rgba(14,122,85,0.18);
  }
  .kl-chips {
    margin-top: 14px;
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .kl-chip {
    display: inline-flex; align-items: center;
    padding: 3px 10px; border-radius: 100px;
    background: var(--color-canvas-soft);
    font: 400 12px/16px var(--font-mono);
    color: var(--color-body);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .kompetens-long-card {
      grid-template-columns: 48px 1fr;
      gap: 16px;
    }
    .kl-num { display: none; }
  }

  .sprak-section {
    border-radius: 24px;
    margin-bottom: 96px;
    padding: 64px 48px;
    position: relative;
    overflow: hidden;
    background: var(--gray-1000);
    color: var(--color-on-primary);
  }
  .sprak-glow {
    position: absolute; top: -160px; right: -160px; width: 480px; height: 480px;
    background: radial-gradient(closest-side, rgba(22,176,121,0.35), transparent);
    filter: blur(40px);
  }
  .sprak-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .sprak-col-label {
    font: 400 11px/16px var(--font-mono);
    color: rgba(255,255,255,0.55);
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.10);
  }
  .sprak-pills {
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .sprak-pill {
    display: inline-flex; align-items: center;
    padding: 6px 12px; border-radius: 100px;
    background: rgba(255,255,255,0.06);
    font: 400 13px/16px var(--font-mono);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.10);
    transition: background-color 120ms ease;
    white-space: nowrap;
  }
  .sprak-pill:hover { background: rgba(255,255,255,0.12); }
  @media (max-width: 760px) {
    .sprak-cols { grid-template-columns: 1fr; gap: 32px; }
    .sprak-section { padding: 48px 24px; }
  }

  .metod-section { padding-top: 24px; padding-bottom: 24px; }
  .metod-timeline { list-style: none; margin: 0; padding: 0; }
  .metod-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 32px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--color-hairline);
    position: relative;
  }
  .metod-row:last-child { padding-bottom: 8px; }
  .metod-rail {
    position: relative;
    display: flex; flex-direction: column; align-items: center;
  }
  .metod-node {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--color-canvas);
    color: var(--color-ink);
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
    flex-shrink: 0; z-index: 1;
  }
  .metod-row:hover .metod-node {
    background: var(--brand-green);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(22,176,121,0.15);
  }
  .metod-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(180deg, var(--color-hairline-strong) 0%, transparent 100%);
    margin-top: 12px;
  }
  .metod-content { max-width: 720px; padding-top: 4px; }
  .metod-stepmeta {
    display: flex; align-items: baseline; gap: 8px;
    margin-bottom: 8px; white-space: nowrap;
  }
  .metod-step-num {
    font: 500 clamp(40px, 4vw, 56px)/1 var(--font-sans);
    color: var(--color-ink);
    letter-spacing: -0.04em;
  }
  .metod-step-total {
    font: 400 14px/1 var(--font-mono);
    color: var(--color-mute);
    letter-spacing: 0.04em;
    align-self: flex-end;
    padding-bottom: 8px;
  }
  .metod-title {
    font: 600 clamp(22px, 2.4vw, 28px)/1.15 var(--font-sans);
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin: 0 0 12px;
  }
  .metod-body {
    font: 400 17px/1.6 var(--font-sans);
    color: var(--color-body);
    margin: 0; max-width: 640px;
  }
  @media (max-width: 640px) {
    .metod-row {
      grid-template-columns: 40px 1fr;
      gap: 20px; padding: 24px 0 32px;
    }
    .metod-node { width: 40px; height: 40px; border-radius: 10px; }
    .metod-body { font-size: 15px; }
  }
</style>
