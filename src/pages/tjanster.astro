---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Erbjudande',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Erbjudande"
    title="Jag får din teknik att tala samma språk"
    subtitle="När äldre maskinparker ska kopplas upp mot moderna molntjänster eller affärssystem uppstår ofta friktion och kostsamma stopp. Med Carlboms Data får du en oberoende part som bygger det mellanlager som saknas."
    image={{
      src: 'https://images.unsplash.com/photo-1565043666747-69f6646db940?ixlib=rb-4.0.3&auto=format&fit=crop&w=1974&q=80',
      alt: 'Industriell maskinpark',
    }}
  />

  <Content
    tagline="Så här hjälper jag dig"
    title="Analys, tolkning och översättning"
    items={[]}
    image={{
      src: 'https://images.unsplash.com/photo-1620712943543-bcc4688e7485?ixlib=rb-4.0.3&auto=format&fit=crop&w=1965&q=80',
      alt: 'Data och integration',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted">
        Jag analyserar, tolkar och översätter data mellan dina maskiner (OT) och dina affärssystem (IT).
        Genom robust systemintegration skapar jag en stabil arkitektur där informationen flödar precis
        som den ska, dygnet runt.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Kompetensområden med teknisk tyngd -->
  <Features
    title="Kompetensområden"
    subtitle="Carlboms Data kombinerar djup teknisk förståelse för hårdvara med modern mjukvaruutveckling."
    items={[
      {
        title: 'Systemintegration',
        description:
          'API-utveckling (REST, SOAP), databashantering (SQL Server, PostgreSQL, MySQL), backend-skript och middleware som kopplar samman era system.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Automation & PLC',
        description:
          'Programmering och optimering av styrsystem med CODESYS. Leverantörsoberoende, IEC 61131-3-baserat och portabelt över hårdvaruplattformar.',
        icon: 'tabler:cpu',
      },
      {
        title: 'HMI, SCADA & övervakning',
        description:
          'Utveckling av operatörsgränssnitt, SCADA-system och realtidsövervakning. CODESYS, WinCC, WideQuick, FUXA samt egenutvecklade webbaserade gränssnitt med larmhantering.',
        icon: 'tabler:device-desktop-analytics',
      },
      {
        title: 'Mjukvaruutveckling',
        description:
          'Python, C#/.NET, T-SQL, CODESYS Structured Text, JavaScript, Flux, HTML/CSS. Skräddarsydda applikationer, backend-tjänster och databearbetning.',
        icon: 'tabler:code',
      },
      {
        title: 'Nätverk & fjärråtkomst',
        description:
          'VPN, nätverkssegmentering (IT/OT), brandväggar och säker fjärranslutning till industriella anläggningar.',
        icon: 'tabler:network',
      },
      {
        title: 'Felsökning & optimering',
        description:
          'Diagnostik av PLC-logik, nätverkskonfiguration, databasstrukturer och applikationskod. Prestandaoptimering av befintliga system.',
        icon: 'tabler:bug',
      },
    ]}
  />

  <!-- Språk & protokoll -->
  <Features2
    title="Språken jag talar"
    subtitle="Oavsett hur dina system kommunicerar idag, ser jag till att datan struktureras och landar rätt."
    columns={2}
    items={[
      {
        title: 'Programmeringsspråk',
        description:
          'C#/.NET · Python · T-SQL · CODESYS Structured Text · HTML/CSS · JavaScript · Flux · Markdown · Inno Setup',
        icon: 'tabler:code',
      },
      {
        title: 'Protokoll & teknologier',
        description:
          'J1939 CAN bus · Modbus · OPC UA · UDP/NVL · TCP (SysSocket) · WireGuard · HTTP/REST · ODBC · SMB · SSH · DNS · VLAN',
        icon: 'tabler:transfer-vertical',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Arbetsprocess (copywriterns 4-stegsmetod) -->
  <Steps
    title="Min metod för lyckad systemintegration"
    subtitle="En beprövad process i fyra steg för att säkerställa att din produktion aldrig äventyras."
    items={[
      {
        title: 'Steg 1: <span class="font-medium">Analys & arkitektur</span>',
        description:
          'Jag börjar med att kartlägga din nätverkstopologi och befintliga protokoll. Sedan definierar jag var kommunikationen brister och designar en säker lösning som inte belastar dina existerande system.',
        icon: 'tabler:search',
      },
      {
        title: 'Steg 2: <span class="font-medium">Integration & utveckling</span>',
        description:
          'Själva hantverket. Jag bygger den logik, de skript och de broar som krävs för att systemen ska kunna utbyta data sömlöst och autonomt.',
        icon: 'tabler:code',
      },
      {
        title: 'Steg 3: <span class="font-medium">Stresstestning i trygg miljö</span>',
        description:
          'För att garantera noll stopptid verifierar och stresstestar jag alltid integrationen noggrant innan den driftsätts i din skarpa produktionsmiljö.',
        icon: 'tabler:test-pipe',
      },
      {
        title: 'Steg 4: <span class="font-medium">Överlämning inkl. källkod</span>',
        description:
          'När relationen mellan systemen är på plats får du full dokumentation. Inga inlåsningseffekter — du äger alltid lösningen och källkoden fullt ut.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'Arbetsprocess i industrimiljö',
    }}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Boka rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
    title="Redo att få systemen att prata med varandra?"
    subtitle="Beskriv din utmaning kort, så hör jag av mig för ett förutsättningslöst rådgivningsmöte."
  />
</Layout>
