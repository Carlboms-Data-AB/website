---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';

import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Erbjudande',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Erbjudande"
    title="Jag får din teknik att tala samma språk"
    image={{
      src: '/images/data-flow.svg',
      alt: 'Dataflöde mellan system',
    }}
  />

  <Content
    title="Så här hjälper jag dig"
    items={[]}
    image={{
      src: '/images/bridge.svg',
      alt: 'Bro mellan OT och IT',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        När äldre maskinparker ska kopplas upp mot moderna molntjänster eller affärssystem uppstår ofta
        friktion och kostsamma stopp. Med Carlboms Data får du en oberoende part som bygger det mellanlager
        (middleware) som saknas.
      </p>
      <p class="text-lg text-muted">
        Som analyserar, tolkar och översätter data mellan dina maskiner (OT) och dina affärssystem (IT).
        Genom robust systemintegration skapar jag en stabil arkitektur där informationen flödar precis
        som den ska, dygnet runt.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Kompetensområden med teknisk tyngd -->
  <Features
    title="Mina kompetensområden"
    subtitle="Carlboms Data kombinerar djup teknisk förståelse för hårdvara med modern mjukvaruutveckling inom:"
    items={[
      {
        title: 'Systemintegration',
        description:
          'Jag bygger mellanlaget som får era system att prata med varandra — API:er, databaskopplingar och middleware som håller datan i flöde.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Automation & PLC',
        description:
          'Programmering och optimering av styrsystem med CODESYS — portabelt över hårdvaruplattformar, utan inlåsning hos en enda leverantör.',
        icon: 'tabler:cpu',
      },
      {
        title: 'HMI, SCADA & övervakning',
        description:
          'Operatörsgränssnitt och SCADA-lösningar som ger er full överblick. Jag jobbar med allt från WinCC och FUXA till helt egenutvecklade webbgränssnitt.',
        icon: 'tabler:device-desktop-analytics',
      },
      {
        title: 'Mjukvaruutveckling',
        description:
          'Skräddarsydda applikationer, backend-tjänster och databearbetning — i det språk och den miljö som passar just din utmaning.',
        icon: 'tabler:code',
      },
      {
        title: 'Nätverk & fjärråtkomst',
        description:
          'VPN, segmentering mellan IT och OT, brandväggar — och säker fjärråtkomst så att ni slipper skicka ut tekniker vid varje larm.',
        icon: 'tabler:network',
      },
      {
        title: 'Felsökning & optimering',
        description:
          'Något som inte fungerar som det ska? Jag gräver i PLC-logik, nätverk, databaser och kod tills jag hittar roten till problemet.',
        icon: 'tabler:bug',
      },
    ]}
  />

  <!-- Språk & protokoll -->
  <Features2
    title="Språken jag talar"
    subtitle="Oavsett om dina system kommunicerar via Modbus, OPC UA, MQTT, REST, JSON eller äldre seriella protokoll, ser jag till att datan struktureras och landar rätt."
    columns={2}
    items={[
      {
        title: 'Programmeringsspråk',
        description:
          'Jag väljer verktyg efter uppgiften: C#/.NET, Python, T-SQL, CODESYS Structured Text, JavaScript, HTML/CSS och mer därtill.',
        icon: 'tabler:code',
      },
      {
        title: 'Protokoll & teknologier',
        description:
          'Från CAN bus och Modbus på fabriksgolvet till REST och OPC UA i molnet — jag pratar de språk som krävs för att koppla ihop din teknik.',
        icon: 'tabler:transfer-vertical',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Arbetsprocess (copywriterns 4-stegsmetod) -->
  <Steps
    title="Min metod för lyckad systemintegration"
    subtitle="Jag har en beprövad process i fyra steg för att säkerställa att din produktion aldrig äventyras."
    items={[
      {
        title: 'Analys & arkitektur',
        description:
          'Jag börjar med att kartlägga din nätverkstopologi och befintliga protokoll. Sedan definierar jag var kommunikationen brister och designar en säker lösning som inte belastar dina existerande system.',
        icon: 'tabler:search',
      },
      {
        title: 'Integration & utveckling',
        description:
          'Själva hantverket. Jag bygger den logik, de skript och de broar som krävs för att systemen ska kunna utbyta data sömlöst och autonomt.',
        icon: 'tabler:code',
      },
      {
        title: 'Stresstestning i trygg miljö',
        description:
          'För att garantera noll stopptid verifierar och stresstestar jag alltid integrationen noggrant innan den driftsätts i din skarpa produktionsmiljö.',
        icon: 'tabler:test-pipe',
      },
      {
        title: 'Överlämning inkl. källkod',
        description:
          'När relationen mellan systemen är på plats får du full dokumentation. Inga inlåsningseffekter — du äger alltid lösningen och källkoden fullt ut.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '/images/process-steps.svg',
      alt: 'Arbetsprocess i fyra steg',
    }}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Boka rådgivningssamtal',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
    title="Redo att få systemen att prata med varandra?"
    subtitle="Beskriv din utmaning kort, så hör jag av mig för ett förutsättningslöst rådgivningsmöte."
  />
</Layout>
