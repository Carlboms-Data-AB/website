---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Kontakt',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Kontakt"
    title="Dags att lösa fnurran på tråden?"
    subtitle="Låt oss prata om hur jag kan få dina system att samarbeta bättre. Carlboms Data är baserat i Lund, men bygger integrationer och broar oavsett var du befinner dig."
  />

  <ContactUs
    id="form"
    title="Vad skaver just nu?"
    subtitle="Beskriv din utmaning, så hör jag av mig för ett förutsättningslöst rådgivningsmöte."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Namn',
      },
      {
        type: 'email',
        name: 'email',
        label: 'E-post',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Företag',
      },
    ]}
    textarea={{
      label: 'Beskriv din utmaning',
    }}
    description="Jag svarar normalt inom 24 timmar."
  />

  <Features2
    title="Kontaktuppgifter"
    columns={3}
    items={[
      {
        title: 'Telefon',
        description: '073-566 70 46',
        icon: 'tabler:phone',
      },
      {
        title: 'E-post',
        description: 'tobias@carlbomsdata.se',
        icon: 'tabler:mail',
      },
      {
        title: 'Plats',
        description: 'Baserat i Lund — verksam i hela Sverige',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
