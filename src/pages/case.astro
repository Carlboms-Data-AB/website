---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Referenser',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Referenser"
    title="När systemen hittade tillbaka till varandra"
    subtitle="Med en gedigen erfarenhet av komplex systemintegration vet jag exakt vad som krävs för att bygga broar som håller över tid. Det handlar inte bara om att skriva kod som fungerar problemfritt i bakgrunden, utan om att leverera skräddarsydda lösningar som skapar verkligt värde för din verksamhet i form av minskat krångel, färre produktionsstopp och frigjord tid. Här är några exempel på hur Carlboms Data har hjälpt isolerad teknik att börja samarbeta på riktigt."
  />

  <Content
    isReversed
    items={[
      {
        title: 'Utmaning',
        description:
          'Ute i gruvor och smältverk driftades tunga fordon helt utan överblick — ingen visste hur maskinerna mådde förrän något redan hade gått fel. Dessutom saknades loggning av fordonens beteende över tid.',
      },
      {
        title: 'Lösning',
        description:
          'Byggde ett webbaserat övervaknings- och loggersystem där driftstatus, larm och styrning kunde nås direkt i webbläsaren oavsett var man befann sig.',
      },
      {
        title: 'Resultat',
        description:
          'Problem fångas upp långt innan de förvandlas till kostsamma produktionsstopp. All driftdata loggas säkert för analys och uppföljning.',
      },
    ]}
    image={{
      src: '/images/case-monitoring.svg',
      alt: 'Realtidsövervakning av fordon',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-1">
        Full koll på tunga fordon
      </h3>
      <p class="text-sm text-muted mb-4">Webbutveckling · Realtidsövervakning · Larmhantering · Databasinloggning</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Utmaning',
        description:
          'Data från flera olika produktionssystem behövde knappas in för hand i affärssystemet — en process som slukade enormt mycket tid och som gjorde att fel konstant smög sig in.',
      },
      {
        title: 'Lösning',
        description:
          'Kopplade ihop de olika produktionssystemen med affärssystemet så att all data flödade helt automatiskt och utan mellanhänder.',
      },
      {
        title: 'Resultat',
        description:
          'Ingen mer manuell inmatning. Rapporter som tidigare tog timmar genererades nu på sekunder med betydligt färre fel.',
      },
    ]}
    image={{
      src: '/images/case-integration.svg',
      alt: 'Systemintegration och dataflöden',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-1">
        Smidigare dataflöden utan handpåläggning
      </h3>
      <p class="text-sm text-muted mb-4">Systemintegration · API-utveckling · SQL · Automatiserad rapportering</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Utmaning',
        description:
          'Varje gång något krånglade på en anläggning tvingades en tekniker att åka ut fysiskt — både dyrt och långsamt.',
      },
      {
        title: 'Lösning',
        description:
          'Installerade en säker fjärranslutning som gav teknikerna full tillgång till utrustningen direkt från kontoret eller hemmet.',
      },
      {
        title: 'Resultat',
        description:
          'En felsökning som tidigare krävde en hel resdag klarades av på en kvart.',
      },
    ]}
    image={{
      src: '/images/case-remote.svg',
      alt: 'Säker fjärråtkomst',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-1">
        Närhet på distans för snabbare felsökning
      </h3>
      <p class="text-sm text-muted mb-4">VPN · Nätverkssegmentering · Fjärråtkomst till PLC/HMI</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Utmaning',
        description:
          'Tre olika system för att skriva ut etiketter skapade stora problem. Fel etikett på fel produkt ledde till reklamationer och försenade leveranser.',
      },
      {
        title: 'Lösning',
        description:
          'Byggde ett enda integrerat system som automatiskt hämtade rätt information och skrev ut exakt rätt etikett oavsett produkttyp.',
      },
      {
        title: 'Resultat',
        description:
          'En enda knapp, ett enda system. Alla reklamationer på grund av felmärkning försvann helt.',
      },
    ]}
    image={{
      src: '/images/case-label.svg',
      alt: 'Etiketthantering',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-1">
        Rätt etikett på rätt plats — varje gång
      </h3>
      <p class="text-sm text-muted mb-4">Systemintegration · Databaslogik · Utskriftsautomation</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Utmaning',
        description:
          'En kabeltillverkare satt med ett egenutvecklat styrsystem som hade blivit så långsamt att det började påverka hela produktionen negativt.',
      },
      {
        title: 'Lösning',
        description:
          'Istället för att slänga ut allt och börja om optimerade jag den befintliga koden från grunden — helt utan att behöva ersätta själva systemet.',
      },
      {
        title: 'Resultat',
        description:
          'Styrsystemet gick från oanvändbart långsamt till blixtsnabbt och responsivt, vilket sparade kunden flera värdefulla timmar varje dag.',
      },
    ]}
    image={{
      src: '/images/case-optimize.svg',
      alt: 'Kodoptimering och prestanda',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-1">
        Nytt liv i gamla styrsystem
      </h3>
      <p class="text-sm text-muted mb-4">Kodoptimering · PLC-felsökning · Prestandaanalys</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Berätta om din utmaning',
        href: '/kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Har du en liknande utmaning?</Fragment>
    <Fragment slot="subtitle">
      Beskriv din situation kort, så hör jag av mig för ett förutsättningslöst rådgivningsmöte.
    </Fragment>
  </CallToAction>
</Layout>
