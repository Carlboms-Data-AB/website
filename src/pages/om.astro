---
import Layout from '~/layouts/PageLayout.astro';
import CtaBand from '~/components/site/CtaBand.astro';
import { Image } from 'astro:assets';
import portraitImg from '~/assets/images/tobias-portrait.jpg';

const metadata = {
  title: 'Om Carlboms Data',
  description: 'Den personliga länken i din systempark. Möt Tobias Carlbom — grundare av Carlboms Data AB i Lund.',
};

const varderingar = [
  { title: 'Integritet', body: 'Your secrets are safe with me. Datasäkerhet och personlig moral.', icon: 'M5 11h14v10H5zm3-4a4 4 0 0 1 8 0v4' },
  { title: 'Transparens', body: 'Mina kunder äger alltid lösningen och koden. Inga inlåsningar.', icon: 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zm11 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6z' },
  { title: 'Prestigelöshet', body: 'Jag löser problemet oavsett vem som orsakade det.', icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m18 0v-2a4 4 0 0 0-3-3.87M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zm3 0a3 3 0 1 1 0-1' },
  { title: 'Omtanke', body: 'Jag värnar om din verksamhet och din sinnesro.', icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z' },
];
---

<Layout metadata={metadata} active="om">
  <section class="section" style="background:var(--color-canvas);">
    <div class="container">
      <div class="om-grid">
        <div class="om-text">
          <div class="eyebrow"><span class="dot"></span>Om Carlboms Data</div>
          <h2 class="display-section" style="margin-top:14px;">
            Den personliga länken i din systempark.
          </h2>

          <div class="om-body">
            <p>Jag startade Carlboms Data med en enkel idé: att skapa bra relationer både mellan systemen och med mina kunder.</p>
            <p>I en bransch där systemintegration ofta handlar om att sälja in stora plattformar och låsa in kunden, ville jag vara en prestigelös motreaktion.</p>
            <p>Det är därför jag bygger broar med robusta, skräddarsydda lösningar som håller över tid. Och det är därför jag alltid låter dig äga koden.</p>
            <p>För mig är integritet allt. Din data är trygg hos mig och jag lämnar aldrig ett uppdrag förrän jag vet att relationen mellan dina system fungerar felfritt.</p>
            <p>Jag är den oberoende experten som säkerställer att din teknik samverkar oavsett plattform. Men jag ger dig också det där speciella engagemanget som du bara kan få när du ringer direkt till den som gör jobbet.</p>
            <p>Välkommen till Carlboms Data.</p>
          </div>

          <div class="om-signature">
            <div class="om-sig-script">Vänliga hälsningar,</div>
            <div class="om-sig-name">Tobias Carlbom</div>
            <div class="om-sig-role">Grundare · Carlboms Data AB</div>
          </div>
        </div>

        <div class="om-portrait-wrap">
          <div class="om-portrait">
            <Image src={portraitImg} alt="Tobias Carlbom" width={600} height={800} style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div class="om-portrait-tag">
              <div class="dot-live"></div>
              <span>Tobias Carlbom — Lund, SE</span>
            </div>
          </div>
          <div class="om-portrait-mono">
            <span>$ whoami</span><br/>
            <span style="color:var(--brand-green);">→ hello@carlbomsdata.se</span>
          </div>
        </div>
      </div>

      <!-- Värderingar -->
      <div class="vard-grid">
        {varderingar.map(v => (
          <div class="vard-card">
            <div class="vard-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={v.icon} /></svg>
            </div>
            <div class="vard-title">{v.title}</div>
            <p class="vard-body">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Vill du veta mer?"
    subheading="Slå en signal eller skicka ett mejl — så pratar vi om vad jag kan göra för dig."
    secondaryHref="/referenser"
    secondaryLabel="Se referenser"
  />
</Layout>

<style>
  .om-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 72px;
  }
  .om-body { margin-top: 32px; display: grid; gap: 24px; max-width: 580px; }
  .om-body p {
    font: 400 18px/1.85 var(--font-sans);
    color: var(--color-body);
    margin: 0;
  }
  .om-signature {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .om-sig-script {
    font: 400 16px/1.4 var(--font-sans);
    color: var(--color-body);
  }
  .om-sig-name {
    margin-top: 4px;
    font: 600 22px/1.2 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .om-sig-role {
    margin-top: 4px;
    font: 400 12px/16px var(--font-mono);
    color: var(--color-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .om-portrait-wrap {
    position: sticky; top: 96px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .om-portrait {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--elev-5);
    aspect-ratio: 3/4;
    background: var(--color-canvas-soft);
  }
  .om-portrait img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .om-portrait-tag {
    position: absolute; left: 16px; bottom: 16px;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    font: 500 12px/1 var(--font-sans);
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
  }
  .dot-live {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 0 4px rgba(22,176,121,0.20);
  }
  .om-portrait-mono {
    font: 400 12px/18px var(--font-mono);
    color: var(--color-mute);
    padding: 12px 16px;
    background: var(--color-canvas-soft);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .om-portrait-mono span:first-child { color: var(--color-body); }

  .vard-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  }
  .vard-card {
    padding: 24px;
    background: var(--color-canvas-soft);
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .vard-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--gray-1000); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
  }
  .vard-title {
    font: 600 17px/1.2 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .vard-body {
    margin: 8px 0 0;
    font: 400 13px/18px var(--font-sans);
    color: var(--color-body);
  }

  @media (max-width: 980px) {
    .om-grid { grid-template-columns: 1fr; gap: 40px; }
    .om-portrait-wrap { position: static; }
    .vard-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .vard-grid { grid-template-columns: 1fr; }
  }
</style>
