---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Om oss',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Om oss"
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Carlboms Data AB',
    }}
  >
    <Fragment slot="title">
      Teknik som fungerar<br />
      <span class="text-accent">i verkligheten</span>
    </Fragment>

    <Fragment slot="subtitle">
      Carlboms Data AB är ett konsultbolag specialiserat på mjukvara för industri och automation.
      Vi kombinerar djup teknisk kunskap med förståelse för de verksamheter vi jobbar med — och
      levererar lösningar som faktiskt används.
    </Fragment>
  </Hero>

  <Steps2
    title="Det här driver oss"
    items={[
      {
        title: 'Lösa riktiga problem',
        description:
          'Vi bygger inte teknik för teknikens skull. Varje lösning vi levererar ska göra en konkret skillnad i er vardag — spara tid, minska fel eller ge bättre beslutsunderlag.',
      },
      {
        title: 'Prata klartext',
        description:
          'Ingen jargong, inga overheads fulla av buzzwords. Vi förklarar vad vi gör, varför vi gör det, och vad det kostar. Om vi inte tror vi kan hjälpa er säger vi det.',
      },
      {
        title: 'Långsiktiga relationer',
        description:
          'Våra bästa uppdrag kommer från kunder vi jobbat med länge. Vi vill vara er tekniska partner — inte en leverantör ni byter varje år.',
      },
    ]}
  />

  <Features2
    title="Kompetensområden"
    columns={3}
    items={[
      {
        title: 'Industriell mjukvara',
        description: 'Operatörsgränssnitt, processövervakning, datahantering och styrning.',
        icon: 'tabler:cpu',
      },
      {
        title: 'OT/IT-integration',
        description: 'PLC, SCADA, OPC UA, Modbus, REST API, databaser och molntjänster.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Nätverksteknik',
        description: 'Industriella nätverk, VPN, segmentering och säker fjärråtkomst.',
        icon: 'tabler:network',
      },
      {
        title: 'Webbutveckling',
        description: 'Dashboards, rapportportaler och interna verktyg som webbaserade applikationer.',
        icon: 'tabler:browser',
      },
      {
        title: 'Dataanalys & rapportering',
        description: 'Automatiserad datainsamling, bearbetning och visualisering av processdata.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Python, C#, .NET, SQL',
        description: 'Vi väljer rätt teknik för uppgiften — inte det som råkar vara populärt just nu.',
        icon: 'tabler:code',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ta kontakt',
        href: '/kontakt',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Vill ni veta mer?</Fragment>
    <Fragment slot="subtitle">
      Vi tar gärna ett samtal om hur vi kan hjälpa er. Helt förutsättningslöst.
    </Fragment>
  </CallToAction>
</Layout>
