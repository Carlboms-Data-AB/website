---
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Om Carlboms Data',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Om Carlboms Data"
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Carlboms Data',
    }}
  >
    <Fragment slot="title">
      Den personliga länken <span class="text-accent">i din systempark</span>
    </Fragment>

    <Fragment slot="subtitle">
      Jag startade Carlboms Data med en enkel idé: att skapa bra relationer — både
      mellan systemen och med mina kunder. I en bransch där systemintegration ofta handlar om att
      sälja in stora plattformar och låsa in kunden, ville jag vara en prestigelös motreaktion.
    </Fragment>
  </Hero>

  <Content
    tagline="Min filosofi"
    items={[]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Tobias Carlbom',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-4">
        Det är därför jag bygger broar med robusta, skräddarsydda lösningar som håller över tid.
        Och det är därför jag alltid låter dig äga koden.
      </p>
      <p class="text-lg text-muted mb-4">
        För mig är integritet allt. Din data är trygg hos mig och jag lämnar aldrig ett uppdrag
        förrän jag vet att relationen mellan dina system fungerar felfritt.
      </p>
      <p class="text-lg text-muted">
        Jag är den oberoende experten som säkerställer att din teknik samverkar oavsett plattform.
        Men jag ger dig också det där speciella engagemanget som du bara kan få när du ringer
        direkt till den som gör jobbet.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps2
    title="Varumärkesvärden"
    subtitle="Fyra ord som definierar Carlboms Data."
    items={[
      {
        title: 'Integritet',
        description:
          '"Your secrets are safe with me." Datasäkerhet och personlig moral genomsyrar allt jag gör.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Transparens',
        description:
          'Du äger alltid lösningen och koden. Inga inlåsningar, inga svarta lådor.',
        icon: 'tabler:lock-open',
      },
      {
        title: 'Prestigelöshet',
        description:
          'Jag löser problemet oavsett vem som orsakade det. Inga ego, bara resultat.',
        icon: 'tabler:hand-stop',
      },
      {
        title: 'Omtanke',
        description:
          'Jag värnar om din verksamhet och din sinnesro. Ditt problem är mitt problem tills det är löst.',
        icon: 'tabler:heart',
      },
    ]}
  />

  <Features2
    title="Kompetensområden"
    columns={3}
    items={[
      {
        title: 'Systemintegration',
        description: 'API-utveckling, databashantering (SQL) och backend-skript.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Automation & PLC',
        description: 'Djup kunskap om styrsystem från Siemens, Mitsubishi m.fl.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Industri 4.0 & IoT',
        description: 'Säker uppkoppling av produktionsdata för analys och övervakning.',
        icon: 'tabler:cloud-computing',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kontakta mig',
        href: '/kontakt',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Välkommen till Carlboms Data</Fragment>
    <Fragment slot="subtitle">
      Din relationsexpert för systemintegration.<br />
      <span class="text-sm text-muted">Vänliga hälsningar, Tobias Carlbom</span>
    </Fragment>
  </CallToAction>
</Layout>
