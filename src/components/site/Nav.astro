---
import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';

interface Props {
  active?: string;
}

const { active } = Astro.props;

const links = [
  { href: '/tjanster', label: 'Mina tjänster', key: 'tjanster' },
  { href: '/case', label: 'Referenser', key: 'case' },
  { href: '/om', label: 'Om', key: 'om' },
  { href: '/kontakt', label: 'Kontakt', key: 'kontakt' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-brand">
      <Image src={logoImg} alt="Carlboms Data" width={28} height={28} />
      <span class="nav-brand-word">Carlboms Data</span>
    </a>

    <button class="nav-hamburger" aria-label="Meny" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" class="hamburger-top" />
        <line x1="3" y1="12" x2="21" y2="12" class="hamburger-mid" />
        <line x1="3" y1="18" x2="21" y2="18" class="hamburger-bot" />
      </svg>
    </button>

    <nav class="nav-desktop">
      <ul class="nav-links">
        {links.map(l => (
          <li>
            <a
              class:list={['nav-link', { 'is-active': active === l.key }]}
              href={l.href}
              aria-current={active === l.key ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/kontakt" class="nav-cta">
      Boka rådgivning
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <nav class="nav-mobile" aria-hidden="true">
    <ul class="nav-mobile-links">
      {links.map(l => (
        <li>
          <a
            class:list={['nav-mobile-link', { 'is-active': active === l.key }]}
            href={l.href}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/kontakt" class="cta" style="width:100%;justify-content:center;margin-top:8px;">
      Boka rådgivning
    </a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0; z-index: 50;
    background: rgba(250,250,250,0.78);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav-inner {
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px;
  }
  .nav-brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--color-ink);
  }
  .nav-brand img { width: 28px; height: 28px; display: block; }
  .nav-brand-word {
    font: 600 17px/1 var(--font-sans);
    letter-spacing: -0.4px;
  }
  .nav-links {
    display: flex; gap: 4px;
    list-style: none; margin: 0; padding: 0;
  }
  .nav-link {
    display: inline-flex; align-items: center;
    height: 32px; padding: 0 12px;
    font: 500 14px/1 var(--font-sans);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 100px;
    letter-spacing: -0.1px;
    transition: background-color 120ms ease;
  }
  .nav-link:hover { background: rgba(0,0,0,0.05); }
  .nav-link.is-active {
    background: rgba(0,0,0,0.06);
    color: var(--color-ink);
  }
  .nav-cta {
    display: inline-flex; align-items: center; gap: 6px;
    height: 36px; padding: 0 16px;
    background: var(--color-ink); color: #fff;
    border-radius: 100px;
    font: 500 14px/1 var(--font-sans);
    letter-spacing: -0.1px;
    border: 0; cursor: pointer; text-decoration: none;
    transition: opacity 120ms ease, transform 120ms ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-cta:hover { opacity: .86; }
  .nav-cta:active { transform: scale(.985); }

  .nav-hamburger {
    display: none;
    background: none; border: none; cursor: pointer;
    color: var(--color-ink); padding: 4px;
  }

  .nav-mobile {
    display: none;
    padding: 16px 20px 24px;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav-mobile-links {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 4px;
  }
  .nav-mobile-link {
    display: flex; align-items: center;
    height: 44px; padding: 0 16px;
    font: 500 16px/1 var(--font-sans);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: 10px;
    transition: background-color 120ms ease;
  }
  .nav-mobile-link:hover, .nav-mobile-link.is-active {
    background: rgba(0,0,0,0.05);
  }

  @media (max-width: 820px) {
    .nav-desktop { display: none; }
    .nav-cta { display: none; }
    .nav-hamburger { display: block; }
  }
  .nav-mobile.open {
    display: block;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector('.nav-hamburger');
    const menu = document.querySelector('.nav-mobile');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    });
  });
</script>
