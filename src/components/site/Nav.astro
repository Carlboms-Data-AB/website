---
import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="nav-brand">
      <Image src={logoImg} alt="Carlboms Data" width={28} height={28} />
      <span class="nav-brand-word">Carlboms Data</span>
    </a>

    <a href="#kontakt" class="nav-cta">
      Boka rådgivning
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0; z-index: 50;
    background: rgba(250,250,250,0.78);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav-inner {
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px;
  }
  .nav-brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--color-ink);
  }
  .nav-brand img { width: 28px; height: 28px; display: block; }
  .nav-brand-word {
    font: 600 17px/1 var(--font-sans);
    letter-spacing: -0.4px;
  }
  .nav-cta {
    display: inline-flex; align-items: center; gap: 6px;
    height: 36px; padding: 0 16px;
    background: var(--color-ink); color: #fff;
    border-radius: 100px;
    font: 500 14px/1 var(--font-sans);
    letter-spacing: -0.1px;
    border: 0; cursor: pointer; text-decoration: none;
    transition: opacity 120ms ease, transform 120ms ease;
    white-space: nowrap;
  }
  .nav-cta:hover { opacity: .86; }
  .nav-cta:active { transform: scale(.985); }
</style>
