---
import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
          <Image src={logoImg} alt="Carlboms Data" width={32} height={32} />
          <span style="font:600 18px/1 var(--font-sans);letter-spacing:-0.4px;color:#fff;">
            Carlboms Data
          </span>
        </div>
        <p style="color:rgba(255,255,255,0.65);max-width:320px;font-size:14px;line-height:1.6;">
          Relationsexperten för systemintegration. Bygger broar mellan IT och OT — från Lund, för hela landet.
        </p>
      </div>
      <div class="footer-col">
        <h4>Innehåll</h4>
        <ul>
          <li><a href="/tjanster">Mina tjänster</a></li>
          <li><a href="/case">Referenser</a></li>
          <li><a href="/om">Om Carlboms Data</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Kontakt</h4>
        <ul>
          <li><a href="mailto:hello@carlbomsdata.se">hello@carlbomsdata.se</a></li>
          <li>Lund, Sverige</li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Följ</h4>
        <ul>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Carlboms Data AB · Momsreg. SE559494046101</span>
      <span>Byggt i Lund.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--gray-1000);
    color: rgba(255,255,255,0.72);
    padding: 80px 0 40px;
  }
  .footer a { color: rgba(255,255,255,0.86); text-decoration: none; }
  .footer a:hover { color: #fff; }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }
  .footer-col h4 {
    font: 400 12px/16px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.55);
    margin: 0 0 16px;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .footer-col li { font: 400 14px/20px var(--font-sans); }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.10);
    font: 400 12px/16px var(--font-mono);
    color: rgba(255,255,255,0.45);
  }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .footer-bottom { flex-direction: column; gap: 12px; align-items: flex-start; }
  }
</style>
