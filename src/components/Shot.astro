---
/**
 * A screenshot, or a labelled gap where one is going.
 *
 * A page full of broken image icons is impossible to review. This renders the
 * real image once a file lands in src/assets/images/, and until then draws a
 * placeholder naming the shot that belongs there — so the layout can be judged
 * now and nobody has to guess later which capture goes where.
 */
import { Image } from 'astro:assets';

export interface Props {
  /** File name in src/assets/images, e.g. "designer-hero.png". */
  src?: string;
  /** What the screenshot shows. Becomes the alt text, and the placeholder label. */
  alt: string;
}

const { src, alt } = Astro.props;

// import.meta.glob is resolved at build time, so an image that has not been
// added yet simply is not in the map and the placeholder stands in.
//
// Relative rather than the ~ alias: Vite's glob plugin resolves the pattern
// before Astro's aliases are applied, and rejects one it cannot make absolute.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

const key = src ? Object.keys(images).find((k) => k.endsWith(`/${src}`)) : undefined;
const image = key ? images[key].default : undefined;
---

{
  image ? (
    <figure class="shot">
      <Image src={image} alt={alt} loading="lazy" decoding="async" />
    </figure>
  ) : (
    <div class="shot-placeholder" role="img" aria-label={alt}>
      <span>
        {alt}
        {src && <span class="file">src/assets/images/{src}</span>}
      </span>
    </div>
  )
}
