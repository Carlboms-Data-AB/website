---
/**
 * The page.
 *
 * Sections only — every word comes from the copy object and every rule from
 * brand.css, so this file has no <style> block of its own. That is what keeps
 * the styling identical to Carlboms-Data-AB/rowmantic-print-web: a class that
 * lives in a scoped block cannot be shared, and one that lives in brand.css is
 * shared by construction.
 */
import { Image } from 'astro:assets';
import Contact from '~/components/Contact.astro';
import portrait from '~/assets/images/tobias-portrait.jpg';
import type { Copy } from '~/copy';

export interface Props {
  t: Copy;
}

const { t } = Astro.props;

// Line art, drawn at 24×24 on a single path so an icon is one string. Keyed by
// the name the copy object uses.
const icons: Record<string, string> = {
  'git-merge': 'M7 7a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 0v10m8-4a4 4 0 1 0 4 4 4 4 0 0 0-4-4zm0 0H7',
  cpu: 'M5 5h14v14H5zm4-3v3m6-3v3M5 9h-3m3 6h-3m17-6h3m-3 6h3M9 22v-3m6 3v-3',
  monitor: 'M3 5h18v12H3zm5 16h8m-4-4v4',
  code: 'M8 7l-5 5 5 5m8-10l5 5-5 5',
  'shield-check': 'M12 2l8 4v6c0 5.5-3.8 10.7-8 12-4.2-1.3-8-6.5-8-12V6l8-4zm-2 10l2 2 4-4',
  search: 'M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm10 18l-4-4',
  check: 'M20 6 9 17l-5-5',
};
---

<!-- ------------------------------------------------------------------ hero -->
<section class="hero" id="top">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-wash"></div>
    <div class="hero-grid-texture"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-center">
      <h1 class="display-hero">{t.hero.title}</h1>
      <p class="lead hero-lead">{t.hero.lead}</p>
    </div>

    <div class="hero-actions">
      <a class="cta" href={t.hero.ctaHref}>
        {t.hero.cta}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a class="cta secondary" href={t.hero.ctaSecondaryHref}>{t.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<!-- -------------------------------------------------------------- services -->
<section class="section tight" id="tjanster">
  <div class="container">
    <div class="section-intro">
      <h2 class="display-section">{t.services.title}</h2>
    </div>

    <div class="grid-3">
      {
        t.services.items.map((service, index) => (
          <article class="card service-card">
            <div class="service-head">
              <span class="tile">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[service.icon]} />
                </svg>
              </span>
              <span class="service-num">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="display-card">{service.title}</h3>
            <p class="service-body">{service.body}</p>
            <div class="service-chips">
              {service.chips.map((chip) => (
                <span class="chip">{chip}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- --------------------------------------------------------------- reasons -->
<section class="section tight section--canvas" id="varfor">
  <div class="container">
    <div class="section-intro">
      <h2 class="display-section">{t.reasons.title}</h2>
    </div>

    <div class="reason-grid">
      {
        t.reasons.items.map((reason) => (
          <div class="reason">
            <span class="tile small" aria-hidden="true">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={icons.check} />
              </svg>
            </span>
            <div>
              <h3 class="reason-title">{reason.title}</h3>
              <p class="reason-body">{reason.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ----------------------------------------------------------------- cases -->
<section class="section tight" id="referenser">
  <div class="container">
    <div class="section-intro">
      <h2 class="display-section">{t.cases.title}</h2>
    </div>

    <div class="cases">
      {
        t.cases.items.map((project, index) => (
          <article class="case">
            <div class="case-left">
              <div class="case-meta">
                <span class="case-meta-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="case-meta-sep">·</span>
                <span class="case-meta-cat">{project.category}</span>
              </div>
              <h3 class="case-title">{project.title}</h3>
              <div class="case-client">{project.client}</div>
              <div class="case-tech">
                <div class="case-tech-label">{t.cases.labels.tech}</div>
                <div class="case-tech-chips">
                  {project.tech.map((tech) => (
                    <span class="chip">{tech}</span>
                  ))}
                </div>
              </div>
            </div>

            <div class="case-right">
              <div class="case-block">
                <div class="case-block-label">
                  <span class="case-dot case-dot--challenge" />
                  {t.cases.labels.challenge}
                </div>
                <p>{project.challenge}</p>
              </div>
              <div class="case-block">
                <div class="case-block-label">
                  <span class="case-dot case-dot--solution" />
                  {t.cases.labels.solution}
                </div>
                <p>{project.solution}</p>
              </div>
              <div class="case-block">
                <div class="case-block-label">
                  <span class="case-dot case-dot--result" />
                  {t.cases.labels.result}
                </div>
                <p>{project.result}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ----------------------------------------------------------------- about -->
<section class="section tight section--canvas" id="om">
  <div class="container">
    <div class="about-grid">
      <div>
        <h2 class="display-section">{t.about.title}</h2>
        <div class="about-body">
          {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="about-sign">
          <div class="about-sign-greeting">{t.about.sign.greeting}</div>
          <div class="about-sign-name">{t.about.sign.name}</div>
          <div class="about-sign-role">{t.about.sign.role}</div>
        </div>
      </div>

      <div class="about-portrait-wrap">
        <div class="about-portrait">
          <Image src={portrait} alt={t.about.portraitAlt} width={600} height={800} />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- --------------------------------------------------------------- contact -->
<Contact t={t} />
